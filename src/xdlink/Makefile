# Builds linkhook.bin: Emerald's link hook and the XD shim, for free cart ROM.
#   build/shim.bin   the shim, linked to run at 0x0203E800 (EWRAM)
#   linkhook.bin     the hook, linked at ROM_ADDR, with the shim inside
# xd_tables.c is generated by make_xd_tables.py from XD's link programs.
# Needs agbcc in ../../tools/agbcc and binutils for arm-none-eabi.

AGBCC   := ../../tools/agbcc
CC1     := $(AGBCC)/bin/old_agbcc
PREFIX  := arm-none-eabi-
CPP     := $(PREFIX)cpp
AS      := $(PREFIX)as
LD      := $(PREFIX)ld
OBJCOPY := $(PREFIX)objcopy
NM      := $(PREFIX)nm

ROM_ADDR := 0x089C2000

# "." first so that gba/flash_internal.h here replaces the payload's.
CPPFLAGS := -I $(AGBCC)/include -iquote . -iquote ../../payload/include -nostdinc -undef
CFLAGS   := -O2 -mthumb-interwork -fhex-asm -Wimplicit -Werror
ASFLAGS  := -mcpu=arm7tdmi
LIBS     := -L $(AGBCC)/lib -lgcc -lc
REPRO    := ../../payload/src/repro

BUILD := build
SHIM_OBJS := $(BUILD)/xd_shim.o $(BUILD)/repro_flash.o $(BUILD)/repro_image.o $(BUILD)/repro_cart.o $(BUILD)/repro_scan.o
HOOK_OBJS := $(BUILD)/linkhook.o $(BUILD)/linkhook_asm.o $(BUILD)/xd_tables.o

all: linkhook.bin

linkhook.bin: $(BUILD)/linkhook.elf
	$(OBJCOPY) -O binary $< $@
	cp $@ ../linkhook.bin

$(BUILD)/linkhook.elf: $(HOOK_OBJS) rom.ld
	$(LD) -T rom.ld --defsym ROM_ADDR=$(ROM_ADDR) -Map $(BUILD)/linkhook.map -o $@ $(HOOK_OBJS) $(LIBS)

$(BUILD)/shim.elf: $(SHIM_OBJS) shim.ld
	$(LD) -T shim.ld -Map $(BUILD)/shim.map -o $@ $(SHIM_OBJS) $(LIBS)

$(BUILD)/shim.bin: $(BUILD)/shim.elf
	$(OBJCOPY) -O binary -j .text $< $@

# Addresses in the shim that the hook needs, as #defines.
$(BUILD)/shim_syms.h: $(BUILD)/shim.elf
	$(NM) $< | awk '$$3 ~ /^(Xd_|__shim_|gXdParams$$|gRepro)/ { printf "#define SHIM_%s 0x%s\n", $$3, $$1 }' > $@

$(BUILD)/linkhook.o: linkhook.c $(BUILD)/shim_syms.h xd_link.h xd_params.h
	$(CPP) $(CPPFLAGS) -iquote $(BUILD) $< -o $(BUILD)/linkhook.i
	$(CC1) $(CFLAGS) -o $(BUILD)/linkhook.s < $(BUILD)/linkhook.i
	$(AS) $(ASFLAGS) -o $@ $(BUILD)/linkhook.s

$(BUILD)/linkhook_asm.o: linkhook_asm.s $(BUILD)/shim.bin
	$(AS) $(ASFLAGS) -o $@ $<

$(BUILD)/%.o: %.c *.h gba/*.h | $(BUILD)
	$(CPP) $(CPPFLAGS) $< -o $(BUILD)/$*.i
	$(CC1) $(CFLAGS) -o $(BUILD)/$*.s < $(BUILD)/$*.i
	$(AS) $(ASFLAGS) -o $@ $(BUILD)/$*.s

$(BUILD)/repro_%.o: $(REPRO)/repro_%.c ../../payload/include/repro_*.h gba/*.h | $(BUILD)
	$(CPP) $(CPPFLAGS) $< -o $(BUILD)/repro_$*.i
	$(CC1) $(CFLAGS) -o $(BUILD)/repro_$*.s < $(BUILD)/repro_$*.i
	$(AS) $(ASFLAGS) -o $@ $(BUILD)/repro_$*.s

$(BUILD):
	mkdir -p $@

clean:
	rm -rf $(BUILD) linkhook.bin

.PHONY: all clean
