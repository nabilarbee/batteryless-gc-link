index e097d0d..ebb2a88 100644
--- a/repro_tools/xdlink/linkhook.c
+++ b/repro_tools/xdlink/linkhook.c
@@ -61,7 +61,7 @@ static void PrepareXd(void)
         // The literals are a quick filter; the hash checks the whole program.
         if (lits[0] != EWRAM + p->blobEnd || lits[1] != EWRAM + p->blobStart)
             continue;
-        if (Hash((const void *)EWRAM, p->recvSize) != p->recvHash)
+        if (Hash((const void *)(EWRAM + p->blobStart), p->loaderOffset + XD_LOADER_SIZE - p->blobStart) != p->recvHash)
             continue;
         loader[XD_LOADER_JUMP / 4] = 0xE59FF008;   // ldr pc, [pc, #8]
         loader[XD_LOADER_SPARE / 4] = (u32)XdPostLoadArm;
