index 3273072..f5b35c7 100644
--- a/repro_tools/test/xd_emu_test.py
+++ b/repro_tools/test/xd_emu_test.py
@@ -54,6 +54,7 @@ lib.HostSramWrite8.argtypes = [ctypes.c_uint32, ctypes.c_uint8]
 lib.HostBankWrite8.argtypes = [ctypes.c_uint8]
 lib.SimInit.argtypes = [ctypes.c_int, ctypes.c_uint32]
 lib.SimRom.restype = ctypes.POINTER(ctypes.c_uint8)
+lib.SimSetEraseBlock.argtypes = [ctypes.c_uint32]
 
 
 class SimStats(ctypes.Structure):
@@ -262,9 +263,19 @@ def shim_symbols():
     return syms
 
 
-def phase1(rom, hook, prog_path, matcher):
+def phase1(rom, hook, prog_path, matcher, tweak=False):
     name = os.path.basename(prog_path)
     program = open(prog_path, 'rb').read()
+    if tweak:
+        # As if the GameCube changed a header byte and sent different padding
+        # after the loader: the hook only looks at what the program needs.
+        p = bytearray(program)
+        p[0xBE] ^= 0x5A
+        info0 = analyze_xd.analyze(prog_path, matcher)[0]
+        end = info0['loaderOffset'] + 0x1C4
+        p[end:] = bytes(len(p) - end) + b'\xAA' * 8
+        program = bytes(p)
+        name += ' (header byte and padding changed)'
     info, _, image = analyze_xd.analyze(prog_path, matcher)
     syms = shim_symbols()
     gba = receive(rom, program)
@@ -340,7 +351,10 @@ def find_bytes(gba, needle):
 
 def phase2(state, info, board, rom):
     """XD's start-up up to its save read, from the end of phase 1."""
+    board, _, block = board.partition('/')
     lib.SimInit(BOARDS[board], 7)
+    if block:
+        lib.SimSetEraseBlock(int(block, 16))
     ctypes.memmove(lib.SimRom(), rom, ROM_SIZE)
     return boot_from(state, info)
 
@@ -410,6 +424,7 @@ def main(argv):
     for p in progs:
         gba, info = phase1(rom, hook, p, m)
         states[os.path.basename(p)] = (gba, info)
+    phase1(rom, hook, [p for p in progs if 'maxcng' in p][0], m, tweak=True)
     phase1_others(rom, argv[2], m)
 
     print('phase 2: save on simulated carts (trade program)')
@@ -418,7 +433,7 @@ def main(argv):
              'io': gba.read(0x04000000, 0x1000), 'after_read': 0x02000292,
              'link_save': 0x02000AC4, 'joy_flags': 0x0201F240 + 0x87C}
     check(info['sites']['savePhase'] == [0x02000AC8, 0x02000B00], 'the test assumes the US trade program')
-    for board, writable in (('amd_swapped', True), ('amd_dual', True), ('intel_buffered', True),
+    for board, writable in (('amd_swapped', True), ('amd_swapped/20000', True), ('amd_dual', True), ('intel_buffered', True),
                             ('intel_word', True), ('amd_x16', False)):
         save_test(state, info, board, rom, writable)
 
diff --git a/repro_tools/xdlink/analyze_xd.py b/repro_tools/xdlink/analyze_xd.py
index d094899..7651564 100644
--- a/repro_tools/xdlink/analyze_xd.py
+++ b/repro_tools/xdlink/analyze_xd.py
@@ -261,13 +261,17 @@ def find_save_link(img):
 
 def analyze(path, matcher):
     prog = open(path, 'rb').read()
-    res = {'file': os.path.basename(path), 'recvSize': len(prog) // 4 * 4}
-    res['recvHash'] = fnv_words(prog[:res['recvSize']])
+    res = {'file': os.path.basename(path)}
     ld = find_loader(prog)
     if not ld:
         raise ValueError('no XD loader found')
     off, bstart, bend = ld
     res.update(loaderOffset=off, blobStart=bstart, blobEnd=bend)
+    # The hook hashes what the program needs as received, from the compressed
+    # data to the end of the loader: not the header, not trailing padding.
+    if bstart & 3 or off & 3:
+        raise ValueError('unaligned blob or loader')
+    res['recvHash'] = fnv_words(prog[bstart:off + LOADER_SIZE])
     img, used = lz77_decode(prog, bstart)
     if used > bend:
         raise ValueError('compressed data runs past the blob')
