diff --git a/repro_tools/test/sim_cart.c b/repro_tools/test/sim_cart.c
new file mode 100644
index 0000000..b294acb
--- /dev/null
+++ b/repro_tools/test/sim_cart.c
@@ -0,0 +1,684 @@
+// Simulated bootleg batteryless cart (see sim_cart.h).
+//
+// The chip models follow the AMD (JEDEC) and Intel command sets closely
+// enough to catch wrong sequences, wrong addresses, missing resets,
+// programming without an erase and status polling mistakes.
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include "sim_cart.h"
+
+// Hooks used by repro_hw.h in REPRO_HOST_TEST builds
+uint16_t HostRomRead16(uint32_t offset);
+void HostRomWrite16(uint32_t offset, uint16_t value);
+uint8_t HostSramRead8(uint32_t offset);
+void HostSramWrite8(uint32_t offset, uint8_t value);
+void HostBankWrite8(uint8_t value);
+
+static enum SimBoard sBoard;
+static uint8_t *sRom;
+static uint8_t sSram[SIM_SRAM_SIZE];
+static int sBank;
+static struct SimStats sStats;
+static uint32_t sEraseBlock;
+static char sViolation[256];
+static int sFailErase;
+static int sFailProgram;
+
+static void Violation(const char *msg, uint32_t offset, uint16_t value)
+{
+    sStats.violations++;
+    snprintf(sViolation, sizeof(sViolation), "%s (offset 0x%X value 0x%04X)", msg, offset, value);
+}
+
+const char *SimLastViolation(void) { return sViolation; }
+uint8_t *SimRom(void) { return sRom; }
+uint8_t *SimSram(void) { return sSram; }
+struct SimStats *SimStats(void) { return &sStats; }
+void SimSetEraseBlock(uint32_t size) { sEraseBlock = size; }
+void SimFailNextErase(void) { sFailErase = 1; }
+void SimFailNextProgram(void) { sFailProgram = 1; }
+
+static uint16_t Swap01(uint16_t v)
+{
+    return (v & ~3) | ((v & 1) << 1) | ((v >> 1) & 1);
+}
+
+static uint16_t RomWord(uint32_t offset)
+{
+    return sRom[offset] | (sRom[offset + 1] << 8);
+}
+
+// Clears bits only, like real flash. Returns 0 when the word was not erased.
+static int ProgramWord(uint32_t offset, uint16_t value)
+{
+    uint16_t old = RomWord(offset);
+    uint16_t now = old & value;
+
+    sRom[offset] = now;
+    sRom[offset + 1] = now >> 8;
+    return old == 0xFFFF;
+}
+
+static void EraseBlockAt(uint32_t offset)
+{
+    uint32_t start = offset & ~(sEraseBlock - 1);
+    memset(sRom + start, 0xFF, sEraseBlock);
+    sStats.erases++;
+}
+
+// ------------------------------------------------------------------ AMD
+
+enum { A_READ, A_U1, A_U2, A_AUTOSEL, A_CFI, A_PROG, A_ES, A_EU1, A_EU2, A_BYPASS, A_BYPROG, A_BYEXIT, A_BUSY };
+
+struct AmdLane
+{
+    int state;
+    int afterBusy;       // state to return to when busy ends
+    int busyReads;
+    uint8_t expect;      // final data of the operation, for DQ7
+    int toggle;
+    int failed;          // DQ5 set until reset
+    int swapped;         // D0/D1 swapped on this lane
+    int shift;           // 0 = low byte, 8 = high byte
+    int x8;              // byte mode addressing
+    uint8_t manufacturer;
+    uint16_t device;     // chip-side ID (x16) or per-lane byte (x8)
+};
+
+static struct AmdLane sLanes[2];
+static int sNumLanes;
+static int sAnswersCfiX16; // SIM_AMD_X16 quirk
+
+static uint32_t Unlock1(const struct AmdLane *l) { return l->x8 ? 0xAAA : 0x555; }
+static uint32_t Unlock2(const struct AmdLane *l) { return l->x8 ? 0x555 : 0x2AA; }
+static uint32_t CfiAddr(const struct AmdLane *l) { return l->x8 ? 0xAA : 0x55; }
+
+// Command byte as the chip sees it on this lane.
+static uint8_t LaneCmd(const struct AmdLane *l, uint16_t value)
+{
+    uint16_t v = (value >> l->shift) & 0xFF;
+    return l->swapped ? (uint8_t)Swap01(v) : (uint8_t)v;
+}
+
+static uint8_t LaneOut(const struct AmdLane *l, uint8_t chipValue)
+{
+    return l->swapped ? (uint8_t)Swap01(chipValue) : chipValue;
+}
+
+static void AmdStartBusy(struct AmdLane *l, uint8_t expect, int reads, int returnState)
+{
+    l->state = A_BUSY;
+    l->busyReads = reads;
+    l->expect = expect;
+    l->afterBusy = returnState;
+}
+
+static void AmdWrite(int lane, uint32_t gbaOffset, uint16_t value, int *programmed, int *erased)
+{
+    struct AmdLane *l = &sLanes[lane];
+    uint32_t addr = gbaOffset >> 1;      // chip address seen by this lane
+    uint8_t cmd = LaneCmd(l, value);
+
+    if (l->state == A_BUSY)
+    {
+        // After a timeout (DQ5) only a reset is accepted.
+        if (l->failed && cmd == 0xF0)
+        {
+            l->state = A_READ;
+            l->failed = 0;
+            return;
+        }
+        Violation("AMD: write while busy", gbaOffset, value);
+        return;
+    }
+
+    if (cmd == 0xF0 && l->state != A_PROG && l->state != A_BYPROG && l->state != A_BYPASS && l->state != A_BYEXIT)
+    {
+        l->state = A_READ;
+        l->failed = 0;
+        return;
+    }
+
+    switch (l->state)
+    {
+    case A_READ:
+        if (addr == Unlock1(l) && cmd == 0xAA)
+            l->state = A_U1;
+        else if (addr == CfiAddr(l) && cmd == 0x98)
+            l->state = A_CFI;
+        else if (sAnswersCfiX16 && gbaOffset == 0xAA && cmd == 0x98)
+            l->state = A_CFI;
+        else
+            sStats.strayWrites++;
+        break;
+    case A_U1:
+        l->state = (addr == Unlock2(l) && cmd == 0x55) ? A_U2 : A_READ;
+        break;
+    case A_U2:
+        if (addr != Unlock1(l))
+            l->state = A_READ;
+        else if (cmd == 0x90)
+            l->state = A_AUTOSEL;
+        else if (cmd == 0xA0)
+            l->state = A_PROG;
+        else if (cmd == 0x80)
+            l->state = A_ES;
+        else if (cmd == 0x20)
+            l->state = A_BYPASS;
+        else
+            l->state = A_READ;
+        break;
+    case A_AUTOSEL:
+    case A_CFI:
+        break; // only F0 leaves, handled above
+    case A_PROG:
+    case A_BYPROG:
+    {
+        int returnState = (l->state == A_BYPROG) ? A_BYPASS : A_READ;
+        uint8_t data = (value >> l->shift) & 0xFF;   // GBA-side data
+        uint8_t old = sRom[gbaOffset + (l->shift ? 1 : 0)];
+
+        if (old != 0xFF && data != 0xFF)
+            Violation("AMD: programming a byte that is not erased", gbaOffset, value);
+        sRom[gbaOffset + (l->shift ? 1 : 0)] = old & data;
+        *programmed = 1;
+        if (sFailProgram)
+        {
+            l->failed = 1;
+            AmdStartBusy(l, data, 1 << 30, returnState);
+        }
+        else
+        {
+            AmdStartBusy(l, data, 2 + lane, returnState);
+        }
+        break;
+    }
+    case A_ES:
+        l->state = (addr == Unlock1(l) && cmd == 0xAA) ? A_EU1 : A_READ;
+        break;
+    case A_EU1:
+        l->state = (addr == Unlock2(l) && cmd == 0x55) ? A_EU2 : A_READ;
+        break;
+    case A_EU2:
+        if (cmd == 0x30)
+        {
+            *erased = 1;
+            if (sFailErase)
+            {
+                l->failed = 1;
+                AmdStartBusy(l, 0xFF, 1 << 30, A_READ);
+            }
+            else
+            {
+                AmdStartBusy(l, 0xFF, 40 + lane * 7, A_READ);
+            }
+        }
+        else
+        {
+            l->state = A_READ;
+        }
+        break;
+    case A_BYPASS:
+        if (cmd == 0xA0)
+            l->state = A_BYPROG;
+        else if (cmd == 0x90)
+            l->state = A_BYEXIT;
+        else
+            Violation("AMD: unexpected command in unlock bypass", gbaOffset, value);
+        break;
+    case A_BYEXIT:
+        if (cmd == 0x00)
+            l->state = A_READ;
+        else
+            Violation("AMD: bad unlock bypass exit", gbaOffset, value);
+        break;
+    }
+}
+
+static uint8_t AmdRead(int lane, uint32_t gbaOffset)
+{
+    struct AmdLane *l = &sLanes[lane];
+    uint32_t addr = gbaOffset >> 1;
+    uint8_t array = sRom[gbaOffset + (l->shift ? 1 : 0)];
+
+    switch (l->state)
+    {
+    case A_BUSY:
+        if (!l->failed && --l->busyReads <= 0)
+        {
+            l->state = l->afterBusy;
+            return array;
+        }
+        l->toggle ^= 0x40;
+        return LaneOut(l, (uint8_t)((~l->expect & 0x80) | l->toggle | (l->failed ? 0x20 : 0)));
+    case A_AUTOSEL:
+        if ((addr & 0xFF) == 0)
+            return LaneOut(l, l->manufacturer);
+        if ((addr & 0xFF) == 1)
+            return LaneOut(l, (uint8_t)(l->x8 ? l->device : (l->shift ? l->device >> 8 : l->device)));
+        return 0;
+    case A_CFI:
+    {
+        static const uint8_t qry[] = {'Q', 'R', 'Y'};
+        uint32_t index = l->x8 ? addr / 2 : addr;
+        if (sAnswersCfiX16)
+            index = addr;
+        if (index >= 0x10 && index <= 0x12 && (!l->x8 || sAnswersCfiX16 || (addr & 1) == 0))
+            return LaneOut(l, qry[index - 0x10]);
+        return 0;
+    }
+    default:
+        return array;
+    }
+}
+
+// ------------------------------------------------------------------ Intel
+
+enum { I_ARRAY, I_STATUS, I_ID, I_CFI };
+enum { P_NONE, P_LOCK, P_ERASE, P_WORD, P_BUFCOUNT, P_BUFDATA, P_BUFCONFIRM };
+
+static struct
+{
+    int mode;
+    int pending;
+    uint8_t sr;
+    int busyReads;
+    int swapped;
+    int mlc;            // 1 KiB regions programmed once, buffered programming only
+    uint8_t manufacturer;
+    uint16_t device;
+    uint8_t locked[SIM_ROM_SIZE / 0x10000];
+    uint32_t bufStart;
+    int bufCount;
+    int bufIndex;
+    uint32_t bufAddr[1024];
+    uint16_t bufData[1024];
+} sIntel;
+
+static uint32_t BlockIndex(uint32_t offset) { return offset / 0x10000; }
+
+static void IntelSetLock(uint32_t offset, int locked)
+{
+    uint32_t start = offset & ~(sEraseBlock - 1);
+    uint32_t i;
+    for (i = start; i < start + sEraseBlock; i += 0x10000)
+        sIntel.locked[BlockIndex(i)] = locked;
+}
+
+static void IntelWrite(uint32_t gbaOffset, uint16_t value, int *programmed, int *erased)
+{
+    uint16_t chip = sIntel.swapped ? Swap01(value) : value;
+    uint8_t cmd = (uint8_t)chip;
+
+    if (sIntel.busyReads > 0)
+    {
+        Violation("Intel: write while busy", gbaOffset, value);
+        return;
+    }
+
+    switch (sIntel.pending)
+    {
+    case P_LOCK:
+        sIntel.pending = P_NONE;
+        if (cmd == 0xD0)
+            IntelSetLock(gbaOffset, 0);
+        else if (cmd == 0x01)
+            IntelSetLock(gbaOffset, 1);
+        else
+            Violation("Intel: bad lock command", gbaOffset, value);
+        sIntel.mode = I_STATUS;
+        return;
+    case P_ERASE:
+        sIntel.pending = P_NONE;
+        sIntel.mode = I_STATUS;
+        if (cmd != 0xD0)
+        {
+            sIntel.sr |= 0x30;
+            Violation("Intel: erase without confirm", gbaOffset, value);
+            return;
+        }
+        *erased = 1;
+        if (sIntel.locked[BlockIndex(gbaOffset)])
+        {
+            sIntel.sr |= 0x22;
+            Violation("Intel: erase of a locked block", gbaOffset, value);
+            return;
+        }
+        if (sFailErase)
+        {
+            sIntel.sr |= 0x20;
+            sFailErase = 0;
+            sIntel.busyReads = 5;
+            return;
+        }
+        EraseBlockAt(gbaOffset);
+        sStats.erases--; // counted by caller
+        sIntel.busyReads = 30;
+        return;
+    case P_WORD:
+        sIntel.pending = P_NONE;
+        sIntel.mode = I_STATUS;
+        *programmed = 1;
+        if (sIntel.mlc)
+            Violation("Intel MLC: word program", gbaOffset, value);
+        if (sIntel.locked[BlockIndex(gbaOffset)])
+        {
+            sIntel.sr |= 0x12;
+            Violation("Intel: program of a locked block", gbaOffset, value);
+            return;
+        }
+        if (sFailProgram)
+        {
+            sIntel.sr |= 0x10;
+            sIntel.busyReads = 2;
+            return;
+        }
+        if (!ProgramWord(gbaOffset, value) && value != 0xFFFF)
+            Violation("Intel: programming a word that is not erased", gbaOffset, value);
+        sIntel.busyReads = 2;
+        return;
+    case P_BUFCOUNT:
+        sIntel.bufCount = chip + 1;
+        sIntel.bufIndex = 0;
+        sIntel.bufStart = gbaOffset;
+        if (sIntel.bufCount > 512)
+            Violation("Intel: buffer too large", gbaOffset, value);
+        sIntel.pending = P_BUFDATA;
+        return;
+    case P_BUFDATA:
+        if (sIntel.bufIndex < 1024)
+        {
+            sIntel.bufAddr[sIntel.bufIndex] = gbaOffset;
+            sIntel.bufData[sIntel.bufIndex] = value;
+        }
+        if (++sIntel.bufIndex == sIntel.bufCount)
+            sIntel.pending = P_BUFCONFIRM;
+        return;
+    case P_BUFCONFIRM:
+    {
+        int i;
+        uint32_t region = sIntel.bufStart & ~0x3FF;
+
+        sIntel.pending = P_NONE;
+        sIntel.mode = I_STATUS;
+        *programmed = 1;
+        if (cmd != 0xD0)
+        {
+            sIntel.sr |= 0x30;
+            Violation("Intel: buffer without confirm", gbaOffset, value);
+            return;
+        }
+        if (sIntel.locked[BlockIndex(sIntel.bufStart)])
+        {
+            sIntel.sr |= 0x12;
+            Violation("Intel: buffer program of a locked block", gbaOffset, value);
+            return;
+        }
+        if (sIntel.mlc)
+        {
+            for (i = 0; i < 0x400; i += 2)
+            {
+                if (RomWord(region + i) != 0xFFFF)
+                {
+                    Violation("Intel MLC: region programmed twice", region, 0);
+                    break;
+                }
+            }
+        }
+        for (i = 0; i < sIntel.bufCount; i++)
+        {
+            if ((sIntel.bufAddr[i] & ~0x3FF) != region)
+                Violation("Intel: buffer crosses a 1 KiB region", sIntel.bufAddr[i], 0);
+            if (!ProgramWord(sIntel.bufAddr[i], sIntel.bufData[i]) && sIntel.bufData[i] != 0xFFFF && !sIntel.mlc)
+                Violation("Intel: programming a word that is not erased", sIntel.bufAddr[i], sIntel.bufData[i]);
+        }
+        if (sFailProgram)
+            sIntel.sr |= 0x10;
+        sIntel.busyReads = 4;
+        return;
+    }
+    }
+
+    switch (cmd)
+    {
+    case 0xFF: sIntel.mode = I_ARRAY; break;
+    case 0x70: sIntel.mode = I_STATUS; break;
+    case 0x50: sIntel.sr = 0x80; break;
+    case 0x90: sIntel.mode = I_ID; break;
+    case 0x98: sIntel.mode = I_CFI; break;
+    case 0x60: sIntel.pending = P_LOCK; break;
+    case 0x20: sIntel.pending = P_ERASE; break;
+    case 0x40:
+    case 0x10: sIntel.pending = P_WORD; break;
+    case 0xE8:
+    case 0xE9: sIntel.pending = P_BUFCOUNT; sIntel.mode = I_STATUS; break;
+    default:
+        sIntel.sr |= 0x30;
+        sIntel.mode = I_STATUS;
+        Violation("Intel: unknown command", gbaOffset, value);
+        break;
+    }
+}
+
+static uint16_t IntelRead(uint32_t gbaOffset)
+{
+    uint16_t chip;
+
+    if (sIntel.busyReads > 0)
+    {
+        sIntel.busyReads--;
+        chip = sIntel.sr & 0x7F;
+    }
+    else if (sIntel.mode == I_STATUS)
+    {
+        chip = sIntel.sr;
+    }
+    else if (sIntel.mode == I_ID)
+    {
+        uint32_t word = (gbaOffset & (sEraseBlock - 1)) >> 1;
+        if (gbaOffset == 0)
+            chip = sIntel.manufacturer;
+        else if (gbaOffset == 2)
+            chip = sIntel.device;
+        else if (word == 1 || word == 2)
+            chip = sIntel.locked[BlockIndex(gbaOffset)]; // block lock status
+        else
+            chip = 0;
+    }
+    else if (sIntel.mode == I_CFI)
+    {
+        uint32_t word = gbaOffset >> 1;
+        chip = (word == 0x10) ? 'Q' : (word == 0x11) ? 'R' : (word == 0x12) ? 'Y' : 0;
+    }
+    else
+    {
+        return RomWord(gbaOffset);
+    }
+
+    return sIntel.swapped ? Swap01(chip) : chip;
+}
+
+// ------------------------------------------------------------------ hooks
+
+uint16_t HostRomRead16(uint32_t offset)
+{
+    offset &= SIM_ROM_SIZE - 2;
+
+    switch (sBoard)
+    {
+    case SIM_INTEL_BUFFERED:
+    case SIM_INTEL_WORD:
+        return IntelRead(offset);
+    case SIM_AMD_SWAPPED:
+    {
+        // One x16 chip: status and IDs come from the chip, array data is 16 bits.
+        int before = sLanes[0].state;
+        uint16_t lo = AmdRead(0, offset);
+        uint16_t hi = 0;
+        int after = sLanes[0].state;
+
+        if (before == A_READ || before == A_BYPASS || (before == A_BUSY && after != A_BUSY))
+            hi = sRom[offset + 1];
+        else if (before == A_AUTOSEL && ((offset >> 1) & 0xFF) == 1)
+            hi = sLanes[0].device >> 8;
+        return lo | (hi << 8);
+    }
+    case SIM_AMD_DUAL:
+    case SIM_AMD_X16:
+        return AmdRead(0, offset) | (AmdRead(1, offset) << 8);
+    default:
+        return RomWord(offset);
+    }
+}
+
+void HostRomWrite16(uint32_t offset, uint16_t value)
+{
+    int programmed = 0, erased = 0;
+
+    offset &= SIM_ROM_SIZE - 2;
+
+    switch (sBoard)
+    {
+    case SIM_INTEL_BUFFERED:
+    case SIM_INTEL_WORD:
+        IntelWrite(offset, value, &programmed, &erased);
+        break;
+    case SIM_AMD_SWAPPED:
+    {
+        // One x16 chip: commands come from the low byte, data is 16 bits.
+        struct AmdLane *l = &sLanes[0];
+        int wasProg = (l->state == A_PROG || l->state == A_BYPROG);
+        AmdWrite(0, offset, value, &programmed, &erased);
+        if (wasProg && programmed)
+        {
+            uint8_t oldHi = sRom[offset + 1];
+            if (oldHi != 0xFF && (value >> 8) != 0xFF)
+                Violation("AMD: programming a byte that is not erased", offset, value);
+            sRom[offset + 1] = oldHi & (value >> 8);
+        }
+        if (erased && !sFailErase)
+            EraseBlockAt(offset);
+        break;
+    }
+    case SIM_AMD_DUAL:
+    case SIM_AMD_X16:
+        AmdWrite(1, offset, value, &programmed, &erased);
+        AmdWrite(0, offset, value, &programmed, &erased);
+        if (erased && !sFailErase)
+            EraseBlockAt(offset);
+        break;
+    default:
+        sStats.strayWrites++;
+        break;
+    }
+
+    if (erased)
+    {
+        sStats.erases += (sBoard == SIM_INTEL_BUFFERED || sBoard == SIM_INTEL_WORD) ? 1 : 0;
+        sFailErase = 0;
+    }
+    if (programmed)
+    {
+        sStats.programs++;
+        sFailProgram = 0;
+    }
+}
+
+uint8_t HostSramRead8(uint32_t offset)
+{
+    return sSram[(sBank << 16) | (offset & 0xFFFF)];
+}
+
+void HostSramWrite8(uint32_t offset, uint8_t value)
+{
+    sSram[(sBank << 16) | (offset & 0xFFFF)] = value;
+}
+
+void HostBankWrite8(uint8_t value)
+{
+    int ok = (value == 0 || value == 1);
+
+    if (sBoard == SIM_AMD_SWAPPED && (value == 0xEE || value == 0xEF))
+        ok = 1;
+    if (!ok)
+        sStats.badBankWrites++;
+    sBank = value & 1;
+}
+
+void SimInit(enum SimBoard board, uint32_t seed)
+{
+    uint32_t i, x = seed;
+
+    if (!sRom)
+        sRom = malloc(SIM_ROM_SIZE);
+    for (i = 0; i < SIM_ROM_SIZE; i++)
+    {
+        x = x * 1103515245 + 12345;
+        sRom[i] = x >> 16;
+    }
+    // Cart header: branch over the header, as on a real cart.
+    sRom[0] = 0x2E; sRom[1] = 0x00; sRom[2] = 0x00; sRom[3] = 0xEA;
+    memcpy(sRom + 0xA0, "POKEMON EMERBPEE01", 18);
+    for (i = 0; i < SIM_SRAM_SIZE; i++)
+    {
+        x = x * 1103515245 + 12345;
+        sSram[i] = x >> 16;
+    }
+
+    memset(&sStats, 0, sizeof(sStats));
+    memset(sLanes, 0, sizeof(sLanes));
+    memset(&sIntel, 0, sizeof(sIntel));
+    sViolation[0] = 0;
+    sFailErase = sFailProgram = 0;
+    sAnswersCfiX16 = 0;
+    sBank = 0;
+    sBoard = board;
+
+    switch (board)
+    {
+    case SIM_AMD_SWAPPED:
+        sNumLanes = 1;
+        sLanes[0].swapped = 1;
+        sLanes[0].manufacturer = 0x01;
+        sLanes[0].device = 0x227E; // reads as 0x227D through the D0/D1 swap
+        sEraseBlock = 0x10000;
+        break;
+    case SIM_AMD_DUAL:
+    case SIM_AMD_X16:
+        sNumLanes = 2;
+        sLanes[0].swapped = 1;
+        sLanes[0].x8 = 1;
+        sLanes[1].x8 = 1;
+        sLanes[1].shift = 8;
+        sLanes[0].manufacturer = sLanes[1].manufacturer = 0xC2;
+        sLanes[0].device = sLanes[1].device = 0x7E;
+        sEraseBlock = 0x20000; // 64 KiB sectors on each x8 chip
+        if (board == SIM_AMD_X16)
+        {
+            sAnswersCfiX16 = 1;
+            sLanes[0].x8 = sLanes[1].x8 = 0;
+        }
+        break;
+    case SIM_INTEL_BUFFERED:
+        sIntel.swapped = 1;
+        sIntel.mlc = 1;
+        sIntel.manufacturer = 0x89;
+        sIntel.device = 0x887E; // reads as 0x887D through the D0/D1 swap
+        sIntel.sr = 0x80;
+        memset(sIntel.locked, 1, sizeof(sIntel.locked));
+        sEraseBlock = 0x20000;
+        break;
+    case SIM_INTEL_WORD:
+        sIntel.manufacturer = 0x89;
+        sIntel.device = 0x8815;
+        sIntel.sr = 0x80;
+        memset(sIntel.locked, 1, sizeof(sIntel.locked));
+        sEraseBlock = 0x10000;
+        break;
+    default:
+        sEraseBlock = 0x10000;
+        break;
+    }
+}
diff --git a/repro_tools/test/sim_cart.h b/repro_tools/test/sim_cart.h
new file mode 100644
index 0000000..b721c74
--- /dev/null
+++ b/repro_tools/test/sim_cart.h
@@ -0,0 +1,39 @@
+// Simulated bootleg batteryless cart for host tests: ROM flash chip(s) with
+// AMD or Intel command sets, optional D0/D1 swap, and 128 KiB banked SRAM.
+#ifndef SIM_CART_H
+#define SIM_CART_H
+
+#include <stdint.h>
+
+#define SIM_ROM_SIZE  (32 * 1024 * 1024)
+#define SIM_SRAM_SIZE (128 * 1024)
+
+enum SimBoard
+{
+    SIM_PLAIN_ROM,       // mask ROM: ignores every write
+    SIM_INTEL_BUFFERED,  // Intel, MLC-style: 1 KiB regions programmed once, buffered only
+    SIM_INTEL_WORD,      // Intel, word programming
+    SIM_AMD_SWAPPED,     // AMD x16, D0/D1 swapped
+    SIM_AMD_DUAL,        // two AMD x8 chips, low chip D0/D1 swapped
+    SIM_AMD_X16,         // AMD x16 that answers CFI on both lanes
+};
+
+struct SimStats
+{
+    unsigned erases;
+    unsigned programs;        // word or buffer program operations
+    unsigned violations;      // reprogramming, programming locked blocks, bad commands
+    unsigned strayWrites;     // writes ignored in read mode
+    unsigned badBankWrites;   // bank register values this board does not use
+};
+
+void SimInit(enum SimBoard board, uint32_t seed);
+uint8_t *SimRom(void);        // array contents as seen by the GBA in read mode
+uint8_t *SimSram(void);       // 128 KiB, bank 0 then bank 1
+struct SimStats *SimStats(void);
+void SimSetEraseBlock(uint32_t size);
+void SimFailNextErase(void);
+void SimFailNextProgram(void);
+const char *SimLastViolation(void);
+
+#endif
diff --git a/repro_tools/test/test_scan.c b/repro_tools/test/test_scan.c
new file mode 100644
index 0000000..d89392c
--- /dev/null
+++ b/repro_tools/test/test_scan.c
@@ -0,0 +1,124 @@
+// Host tests for the save-area scan in payload/src/repro/repro_scan.c.
+// Build: make -C repro_tools/test   Run: ./test_scan [rom_dump.gba]
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include "repro_flash.h"
+
+#define MB (1024 * 1024)
+
+static int failures;
+
+#define CHECK(cond, ...) do { if (!(cond)) { printf("FAIL %s:%d: ", __FILE__, __LINE__); printf(__VA_ARGS__); printf("\n"); failures++; } } while (0)
+
+static void put16(uint8_t *p, uint16_t v) { p[0] = v; p[1] = v >> 8; }
+static void put32(uint8_t *p, uint32_t v) { p[0] = v; p[1] = v >> 8; p[2] = v >> 16; p[3] = v >> 24; }
+
+// Writes one save slot (14 sectors) with ids rotated by 'rotation'.
+static void make_slot(uint8_t *slot, uint32_t counter, int rotation, int breakLastSignature)
+{
+    int i;
+    for (i = 0; i < 14; i++)
+    {
+        uint8_t *sector = slot + i * 0x1000;
+        int id = (i + 14 - rotation) % 14;
+        memset(sector, 0x11 * (id + 1), 0xF80);
+        memset(sector + 0xF80, 0, 0x74);
+        put16(sector + 0xFF4, id);
+        put16(sector + 0xFF6, 0x1234);
+        put32(sector + 0xFF8, 0x08012025);
+        put32(sector + 0xFFC, counter);
+        if (breakLastSignature && id == 13)
+            sector[0xFF8] = 0xFF; // phase-1 state of a link save
+    }
+}
+
+static uint8_t *make_rom(uint32_t size, uint32_t seed)
+{
+    uint8_t *rom = malloc(REPRO_ROM_MAX_SIZE);
+    uint32_t i, x = seed;
+    for (i = 0; i < size; i++)
+    {
+        x = x * 1103515245 + 12345;
+        rom[i] = x >> 16;
+    }
+    memcpy(rom + 0xA0, "POKEMON EMERBPEE01", 18);
+    // Readable window is always 32 MiB; smaller chips mirror.
+    for (i = size; i < REPRO_ROM_MAX_SIZE; i += size)
+        memcpy(rom + i, rom, size);
+    return rom;
+}
+
+static void test_synthetic(void)
+{
+    struct ReproScanResult r;
+    uint8_t *rom;
+
+    // 16 MiB chip mirrored into 32 MiB, both slots complete at 0xFC0000.
+    rom = make_rom(16 * MB, 1);
+    memset(rom + 0xFC0000, 0xFF, 0x20000);
+    make_slot(rom + 0xFC0000, 41, 3, 0);
+    make_slot(rom + 0xFC0000 + 0xE000, 42, 4, 0);
+    memcpy(rom + 16 * MB, rom, 16 * MB);
+    CHECK(ReproGetRomSize(rom) == 16 * MB, "size %x", ReproGetRomSize(rom));
+    CHECK(ReproScanForSave(rom, ReproGetRomSize(rom), &r), "not found");
+    CHECK(r.saveOffset == 0xFC0000, "offset %x", r.saveOffset);
+    CHECK(r.newestCounter == 42, "counter %u", r.newestCounter);
+    CHECK(r.numCandidates == 1, "candidates %u", r.numCandidates);
+    CHECK(r.completeSlots == 3, "slots %u", r.completeSlots);
+    free(rom);
+
+    // 32 MiB chip, only slot B complete, slot A interrupted mid-save.
+    rom = make_rom(32 * MB, 2);
+    memset(rom + 0xF80000, 0xFF, 0x20000);
+    make_slot(rom + 0xF80000, 8, 0, 1);
+    make_slot(rom + 0xF80000 + 0xE000, 7, 13, 0);
+    CHECK(ReproGetRomSize(rom) == 32 * MB, "size %x", ReproGetRomSize(rom));
+    CHECK(ReproScanForSave(rom, ReproGetRomSize(rom), &r), "not found");
+    CHECK(r.saveOffset == 0xF80000, "offset %x", r.saveOffset);
+    CHECK(r.newestCounter == 7, "counter %u", r.newestCounter);
+    CHECK(r.completeSlots == 2, "slots %u", r.completeSlots);
+    free(rom);
+
+    // No save at all.
+    rom = make_rom(16 * MB, 3);
+    CHECK(!ReproScanForSave(rom, ReproGetRomSize(rom), &r), "found a save in random data");
+    free(rom);
+
+    // A save that is not 64 KiB aligned must be ignored rather than misread.
+    rom = make_rom(16 * MB, 4);
+    make_slot(rom + 0xFC1000, 5, 0, 0);
+    make_slot(rom + 0xFC1000 + 0xE000, 6, 0, 0);
+    CHECK(!ReproScanForSave(rom, ReproGetRomSize(rom), &r), "accepted a misaligned save at %x", r.saveOffset);
+    free(rom);
+}
+
+static void test_dump(const char *path)
+{
+    struct ReproScanResult r;
+    uint8_t *rom = calloc(1, REPRO_ROM_MAX_SIZE);
+    FILE *f = fopen(path, "rb");
+    size_t n, i;
+    if (!f) { perror(path); failures++; return; }
+    n = fread(rom, 1, REPRO_ROM_MAX_SIZE, f);
+    fclose(f);
+    // Mirror a short dump the way the cart bus would.
+    for (i = n; n && i < REPRO_ROM_MAX_SIZE; i += n)
+        memcpy(rom + i, rom, (REPRO_ROM_MAX_SIZE - i < n) ? REPRO_ROM_MAX_SIZE - i : n);
+    printf("dump: %zu bytes, readable size 0x%X\n", n, ReproGetRomSize(rom));
+    if (ReproScanForSave(rom, ReproGetRomSize(rom), &r))
+        printf("dump: save at 0x%X, newest counter %u, slots %u, candidates %u\n",
+               r.saveOffset, r.newestCounter, r.completeSlots, r.numCandidates);
+    else
+        printf("dump: no save found\n");
+    free(rom);
+}
+
+int main(int argc, char **argv)
+{
+    test_synthetic();
+    if (argc > 1)
+        test_dump(argv[1]);
+    printf(failures ? "%d FAILURES\n" : "all scan tests passed\n", failures);
+    return failures != 0;
+}
diff --git a/repro_tools/test/test_write.c b/repro_tools/test/test_write.c
new file mode 100644
index 0000000..d9399ab
--- /dev/null
+++ b/repro_tools/test/test_write.c
@@ -0,0 +1,198 @@
+// Host tests for the repro write path: board probing, the SRAM working copy
+// and commits, run against the simulated carts in sim_cart.c.
+// The save sequence below follows libpmagb/save.c (sub_0200A2C8 cases 0 and 1).
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include "sim_cart.h"
+#include "repro_flash.h"
+#include "repro_cart.h"
+#include "repro_image.h"
+
+#define SAVE_OFFSET 0xFC0000
+#define SECTOR 0x1000
+
+static int failures;
+#define CHECK(cond, ...) do { if (!(cond)) { printf("    FAIL line %d: ", __LINE__); printf(__VA_ARGS__); printf("\n"); failures++; } } while (0)
+
+static void put16(uint8_t *p, uint16_t v) { p[0] = v; p[1] = v >> 8; }
+static void put32(uint8_t *p, uint32_t v) { p[0] = v; p[1] = v >> 8; p[2] = v >> 16; p[3] = v >> 24; }
+
+static void make_sector(uint8_t *s, int id, uint32_t counter)
+{
+    int i;
+    for (i = 0; i < 0xF80; i++)
+        s[i] = (uint8_t)(i * 7 + id * 13 + counter * 31);
+    memset(s + 0xF80, 0, 0x74);
+    put16(s + 0xFF4, id);
+    put16(s + 0xFF6, 0xBEEF ^ counter);
+    put32(s + 0xFF8, 0x08012025);
+    put32(s + 0xFFC, counter);
+}
+
+// Physical sector of chunk 'id' in a slot, as HandleWriteSector computes it.
+static int physical(int slot, int id, int rotation)
+{
+    return slot * 14 + (id + rotation) % 14;
+}
+
+static void write_slot_to_rom(uint8_t *rom, int slot, uint32_t counter, int rotation)
+{
+    int id;
+    for (id = 0; id < 14; id++)
+        make_sector(rom + SAVE_OFFSET + physical(slot, id, rotation) * SECTOR, id, counter);
+}
+
+// Phase 1 of a link save into 'slot': 13 sectors programmed whole, the last
+// one erased and programmed byte by byte except the first signature byte.
+static void phase1(int slot, uint32_t counter, int rotation, int *lastSector)
+{
+    uint8_t buf[SECTOR];
+    int id, i;
+
+    for (id = 0; id < 13; id++)
+    {
+        int sector = physical(slot, id, rotation);
+        make_sector(buf, id, counter);
+        ReproImage_Write(sector * SECTOR, buf, SECTOR);
+        CHECK(ReproImage_Compare(sector * SECTOR, buf, SECTOR) == 0, "verify of sector %d failed", sector);
+    }
+
+    *lastSector = physical(slot, 13, rotation);
+    make_sector(buf, 13, counter);
+    ReproImage_Fill(*lastSector * SECTOR, 0xFF, SECTOR);
+    for (i = 0; i < SECTOR; i++)
+    {
+        if (i != 0xFF8)
+            ReproImage_Write(*lastSector * SECTOR + i, &buf[i], 1);
+    }
+}
+
+static void phase2(int lastSector)
+{
+    uint8_t sig = 0x25;
+    ReproImage_Write(lastSector * SECTOR + 0xFF8, &sig, 1);
+}
+
+static int rom_matches_image(const uint8_t *rom, const uint8_t *expected, uint32_t *where)
+{
+    uint32_t i;
+    for (i = 0; i < REPRO_SAVE_SIZE; i++)
+    {
+        if (rom[SAVE_OFFSET + i] != expected[i])
+        {
+            *where = i;
+            return 0;
+        }
+    }
+    return 1;
+}
+
+static const char *sBoardNames[] = {"plain ROM", "Intel buffered", "Intel word", "AMD swapped", "AMD dual x8", "AMD x16"};
+
+static void test_board(enum SimBoard board, int expectedType, int expectSupported)
+{
+    uint8_t *rom;
+    uint8_t *before = malloc(SIM_ROM_SIZE);
+    uint8_t expected[REPRO_SAVE_SIZE];
+    struct ReproScanResult scan;
+    const struct ReproCart *cart;
+    uint32_t where;
+    int lastSector;
+    u16 result;
+    unsigned erasesBefore;
+
+    printf("  %s\n", sBoardNames[board]);
+    SimInit(board, 1234 + board);
+    rom = SimRom();
+
+    // Existing save: slot A counter 10 (rotation 3), slot B counter 9 (rotation 2),
+    // sectors 28-31 hold other data.
+    memset(rom + SAVE_OFFSET, 0xFF, REPRO_SAVE_SIZE);
+    write_slot_to_rom(rom, 0, 10, 3);
+    write_slot_to_rom(rom, 1, 9, 2);
+    make_sector(rom + SAVE_OFFSET + 28 * SECTOR, 0, 77);
+    make_sector(rom + SAVE_OFFSET + 29 * SECTOR, 1, 77);
+    memcpy(before, rom, SIM_ROM_SIZE);
+
+    CHECK(ReproScanForSave(rom, ReproGetRomSize(rom), &scan) && scan.saveOffset == SAVE_OFFSET, "scan");
+
+    cart = ReproCart_Probe();
+    CHECK(cart->type == expectedType, "probe gave type %d, expected %d", cart->type, expectedType);
+    CHECK(cart->supported == expectSupported, "supported flag");
+    CHECK(memcmp(rom, before, SIM_ROM_SIZE) == 0, "probe changed ROM contents");
+    if (!cart->supported)
+    {
+        CHECK(ReproImage_Commit(cart, SAVE_OFFSET) == REPRO_ERR_UNSUPPORTED, "commit on unsupported board");
+        free(before);
+        return;
+    }
+
+    CHECK(ReproImage_Load(SAVE_OFFSET) == REPRO_OK, "load");
+    CHECK(memcmp(SimSram(), rom + SAVE_OFFSET, REPRO_SAVE_SIZE) == 0, "SRAM copy differs from ROM");
+
+    // Nothing changed: commit must not touch the chip.
+    erasesBefore = SimStats()->erases;
+    CHECK(ReproImage_Commit(cart, SAVE_OFFSET) == REPRO_OK, "empty commit");
+    CHECK(SimStats()->erases == erasesBefore && SimStats()->programs == 0, "empty commit wrote to flash");
+
+    // Save 1: counter 11 goes to slot B (11 % 2), rotation (2+1) % 14.
+    phase1(1, 11, 3, &lastSector);
+    result = ReproImage_Commit(cart, SAVE_OFFSET);
+    CHECK(result == REPRO_OK, "phase 1 commit returned 0x%X", result);
+    memcpy(expected, SimSram(), REPRO_SAVE_SIZE);
+    // ROM must match the image except around the pending signature, which stays erased.
+    {
+        uint32_t unit = cart->programUnit;
+        uint32_t sig = lastSector * SECTOR + 0xFF8;
+        uint32_t start = sig & ~(unit - 1);
+        memset(expected + start, 0xFF, unit);
+    }
+    CHECK(rom_matches_image(rom, expected, &where), "after phase 1 ROM differs at save+0x%X", where);
+    CHECK(ReproScanForSave(rom, ReproGetRomSize(rom), &scan) && scan.newestCounter == 10, "after phase 1 the newest valid save must still be 10 (got %u)", scan.newestCounter);
+    CHECK(memcmp(rom, before, SAVE_OFFSET) == 0 && memcmp(rom + SAVE_OFFSET + REPRO_SAVE_SIZE, before + SAVE_OFFSET + REPRO_SAVE_SIZE, SIM_ROM_SIZE - SAVE_OFFSET - REPRO_SAVE_SIZE) == 0, "phase 1 changed ROM outside the save area");
+
+    erasesBefore = SimStats()->erases;
+    phase2(lastSector);
+    result = ReproImage_Commit(cart, SAVE_OFFSET);
+    CHECK(result == REPRO_OK, "phase 2 commit returned 0x%X", result);
+    CHECK(SimStats()->erases == erasesBefore, "phase 2 erased flash");
+    CHECK(rom_matches_image(rom, SimSram(), &where), "after phase 2 ROM differs at save+0x%X", where);
+    CHECK(ReproScanForSave(rom, ReproGetRomSize(rom), &scan) && scan.newestCounter == 11 && scan.completeSlots == 3, "after phase 2: counter %u slots %u", scan.newestCounter, scan.completeSlots);
+
+    // Save 2: counter 12 goes back to slot A, which already holds data.
+    phase1(0, 12, 4, &lastSector);
+    CHECK(ReproImage_Commit(cart, SAVE_OFFSET) == REPRO_OK, "second phase 1 commit");
+    CHECK(ReproScanForSave(rom, ReproGetRomSize(rom), &scan) && scan.newestCounter == 11, "second phase 1: newest %u", scan.newestCounter);
+    phase2(lastSector);
+    CHECK(ReproImage_Commit(cart, SAVE_OFFSET) == REPRO_OK, "second phase 2 commit");
+    CHECK(rom_matches_image(rom, SimSram(), &where), "after second save ROM differs at save+0x%X", where);
+    CHECK(ReproScanForSave(rom, ReproGetRomSize(rom), &scan) && scan.newestCounter == 12 && scan.completeSlots == 3, "after second save: counter %u slots %u", scan.newestCounter, scan.completeSlots);
+    CHECK(memcmp(rom, before, SAVE_OFFSET) == 0 && memcmp(rom + SAVE_OFFSET + REPRO_SAVE_SIZE, before + SAVE_OFFSET + REPRO_SAVE_SIZE, SIM_ROM_SIZE - SAVE_OFFSET - REPRO_SAVE_SIZE) == 0, "ROM changed outside the save area");
+
+    // A failed erase is retried once.
+    phase1(1, 13, 5, &lastSector);
+    SimFailNextErase();
+    result = ReproImage_Commit(cart, SAVE_OFFSET);
+    CHECK(result == REPRO_OK, "commit after one failed erase returned 0x%X", result);
+    phase2(lastSector);
+    CHECK(ReproImage_Commit(cart, SAVE_OFFSET) == REPRO_OK, "phase 2 after retry");
+    CHECK(ReproScanForSave(rom, ReproGetRomSize(rom), &scan) && scan.newestCounter == 13, "after retry: newest %u", scan.newestCounter);
+
+    CHECK(SimStats()->violations == 0, "%u chip protocol violations, last: %s", SimStats()->violations, SimLastViolation());
+    CHECK(SimStats()->badBankWrites == 0, "%u bank register writes with values this board does not use", SimStats()->badBankWrites);
+    printf("    erases %u, program operations %u, stray writes %u\n", SimStats()->erases, SimStats()->programs, SimStats()->strayWrites);
+    free(before);
+}
+
+int main(void)
+{
+    test_board(SIM_PLAIN_ROM, REPRO_CART_UNKNOWN, 0);
+    test_board(SIM_AMD_SWAPPED, REPRO_CART_AMD_SWAPPED, 1);
+    test_board(SIM_AMD_DUAL, REPRO_CART_AMD_DUAL, 1);
+    test_board(SIM_AMD_X16, REPRO_CART_AMD_X16, 0);
+    test_board(SIM_INTEL_BUFFERED, REPRO_CART_INTEL_BUFFERED, 1);
+    test_board(SIM_INTEL_WORD, REPRO_CART_INTEL_WORD, 1);
+    printf(failures ? "%d FAILURES\n" : "all write tests passed\n", failures);
+    return failures != 0;
+}
-- 
2.43.0

