diff --git a/payload/src/repro/repro_cart.c b/payload/src/repro/repro_cart.c
new file mode 100644
index 0000000..2cca454
--- /dev/null
+++ b/payload/src/repro/repro_cart.c
@@ -0,0 +1,535 @@
+// Board detection and flash commands for bootleg batteryless Pokémon carts.
+// See include/repro_cart.h for where the board types come from.
+
+#include "repro_types.h"
+#include "repro_hw.h"
+#include "repro_cart.h"
+
+// Upper bound on status polls before giving up (about 10 s of polling on hardware).
+#define POLL_LIMIT 0x00800000
+
+#define AMD_X16_UNLOCK1  0xAAA   // word address 0x555
+#define AMD_X16_UNLOCK2  0x554   // word address 0x2AA
+#define AMD_X8_UNLOCK1   0x1554  // byte address 0xAAA on each x8 chip
+#define AMD_X8_UNLOCK2   0xAAA   // byte address 0x555 on each x8 chip
+
+static const struct ReproCart sCarts[REPRO_CART_TYPE_COUNT] =
+{
+    [REPRO_CART_UNKNOWN] =
+    {
+        .type = REPRO_CART_UNKNOWN,
+        .supported = FALSE,
+    },
+    [REPRO_CART_INTEL_BUFFERED] =
+    {
+        .type = REPRO_CART_INTEL_BUFFERED,
+        .bankValue = {0, 1},
+        .supported = TRUE,
+        .eraseStride = 0x20000,
+        .programUnit = 0x400,
+        .bufferCmd = 0xEA,
+    },
+    [REPRO_CART_INTEL_WORD] =
+    {
+        .type = REPRO_CART_INTEL_WORD,
+        .bankValue = {0, 1},
+        .supported = TRUE,
+        .eraseStride = 0x10000,
+        .programUnit = 2,
+    },
+    [REPRO_CART_AMD_SWAPPED] =
+    {
+        .type = REPRO_CART_AMD_SWAPPED,
+        .bankValue = {0xEE, 0xEF},
+        .supported = TRUE,
+        .eraseStride = 0x10000,
+        .programUnit = 2,
+        .unlockAddr1 = AMD_X16_UNLOCK1,
+        .unlockAddr2 = AMD_X16_UNLOCK2,
+        .unlockData1 = 0xA9, // 0xAA with D0/D1 swapped
+        .unlockData2 = 0x56, // 0x55 with D0/D1 swapped
+        .cmdMultiplier = 0x0001,
+        .statusMask = 0x0080,
+        .useBypass = FALSE,
+    },
+    [REPRO_CART_AMD_DUAL] =
+    {
+        .type = REPRO_CART_AMD_DUAL,
+        .bankValue = {0, 1},
+        .supported = TRUE,
+        .eraseStride = 0x20000,
+        .programUnit = 2,
+        .unlockAddr1 = AMD_X8_UNLOCK1,
+        .unlockAddr2 = AMD_X8_UNLOCK2,
+        .unlockData1 = 0xAAA9, // high chip 0xAA, low chip 0xAA with D0/D1 swapped
+        .unlockData2 = 0x5556,
+        .cmdMultiplier = 0x0101,
+        .statusMask = 0x8080,
+        .useBypass = TRUE,
+    },
+    [REPRO_CART_AMD_X16] =
+    {
+        // The cart's own code only ever saves the first 64 KiB on this board,
+        // so its bank handling is unknown. Refuse writes.
+        .type = REPRO_CART_AMD_X16,
+        .bankValue = {0, 1},
+        .supported = FALSE,
+        .eraseStride = 0x20000,
+        .programUnit = 2,
+        .unlockAddr1 = AMD_X16_UNLOCK1,
+        .unlockAddr2 = AMD_X16_UNLOCK2,
+        .unlockData1 = 0xAAA9,
+        .unlockData2 = 0x5556,
+        .cmdMultiplier = 0x0101,
+        .statusMask = 0x8080,
+        .useBypass = TRUE,
+    },
+};
+
+// Device IDs (word 1 in Intel identifier mode) and the board type they select.
+static const u16 sIntelBufferedIds[] = {0x8902, 0x8904, 0x887D, 0x88B0};
+static const u16 sIntelWordIds[] =
+{
+    0x8815, 0x8810, 0x880E, 0x8813, 0x880C, 0x880F, 0x8812,
+    0x8816, 0x8855, 0x8857, 0x88C6, 0x88C4, 0x880D,
+};
+
+#define AMD_SWAPPED_DEVICE_ID 0x227D
+#define CFI_QR_BOTH_LANES     0x5152
+
+const struct ReproCart *ReproCart_Get(u8 type)
+{
+    if (type >= REPRO_CART_TYPE_COUNT)
+        type = REPRO_CART_UNKNOWN;
+    return &sCarts[type];
+}
+
+static bool32 InList(u16 id, const u16 *list, u32 count)
+{
+    u32 i;
+
+    for (i = 0; i < count; i++)
+    {
+        if (list[i] == id)
+            return TRUE;
+    }
+
+    return FALSE;
+}
+
+static bool32 IsIntel(const struct ReproCart *cart)
+{
+    return cart->type == REPRO_CART_INTEL_BUFFERED || cart->type == REPRO_CART_INTEL_WORD;
+}
+
+void ReproCart_ReadArrayMode(const struct ReproCart *cart)
+{
+    if (IsIntel(cart))
+    {
+        ROM_WRITE16(0, 0xFF);
+    }
+    else
+    {
+        ROM_WRITE16(0, 0xF0 * cart->cmdMultiplier);
+    }
+}
+
+// Identifies the board with the same probe sequence as the cart's own code,
+// except that an unrecognised chip is refused rather than guessed.
+const struct ReproCart *ReproCart_Probe(void)
+{
+    u16 ime;
+    u16 id;
+    u16 header0, header1;
+    u16 auto0, auto1;
+    u8 type = REPRO_CART_UNKNOWN;
+
+    IRQ_DISABLE(ime);
+
+    header0 = ROM_READ16(0);
+    header1 = ROM_READ16(2);
+
+    // Intel: clear status, read identifier.
+    ROM_WRITE16(0, 0xFF);
+    ROM_WRITE16(0, 0x50);
+    ROM_WRITE16(0, 0x90);
+    id = ROM_READ16(2);
+
+    if (InList(id, sIntelBufferedIds, sizeof(sIntelBufferedIds) / sizeof(sIntelBufferedIds[0])))
+    {
+        ROM_WRITE16(0, 0xFF);
+        type = REPRO_CART_INTEL_BUFFERED;
+        goto done;
+    }
+
+    if (InList(id, sIntelWordIds, sizeof(sIntelWordIds) / sizeof(sIntelWordIds[0])))
+    {
+        ROM_WRITE16(0, 0xFF);
+        type = REPRO_CART_INTEL_WORD;
+        goto done;
+    }
+
+    ROM_WRITE16(0, 0xF0);
+
+    // AMD autoselect, x16, with D0/D1 swapped unlock data.
+    ROM_WRITE16(AMD_X16_UNLOCK1, 0xA9);
+    ROM_WRITE16(AMD_X16_UNLOCK2, 0x56);
+    ROM_WRITE16(AMD_X16_UNLOCK1, 0x90);
+    auto0 = ROM_READ16(0);
+    auto1 = ROM_READ16(2);
+    ROM_WRITE16(0, 0xF0);
+
+    if (auto1 == AMD_SWAPPED_DEVICE_ID)
+    {
+        type = REPRO_CART_AMD_SWAPPED;
+        goto done;
+    }
+
+    // CFI query, two x8 chips in byte mode.
+    ROM_WRITE16(0, 0xF0F0);
+    ROM_WRITE16(0x154, 0x9898);
+    id = ROM_READ16(0x40);
+    ROM_WRITE16(0, 0xF0F0);
+    if (id == CFI_QR_BOTH_LANES)
+    {
+        type = REPRO_CART_AMD_DUAL;
+        goto done;
+    }
+
+    // CFI query, x16.
+    ROM_WRITE16(0xAA, 0x9898);
+    id = ROM_READ16(0x20);
+    ROM_WRITE16(0, 0xF0F0);
+    if (id == CFI_QR_BOTH_LANES)
+    {
+        type = REPRO_CART_AMD_X16;
+        goto done;
+    }
+
+    ROM_WRITE16(0, 0xF0);
+
+    // The cart's own code falls back to the swapped AMD board here. Only do
+    // the same when the chip visibly answered the swapped autoselect command.
+    if (auto0 != header0 || auto1 != header1)
+        type = REPRO_CART_AMD_SWAPPED;
+
+done:
+    ReproCart_ReadArrayMode(&sCarts[type]);
+
+    // The chip must be back in read-array mode before anything continues.
+    if (ROM_READ16(0) != header0 || ROM_READ16(2) != header1)
+    {
+        ROM_WRITE16(0, 0xFF);
+        ROM_WRITE16(0, 0xF0);
+        type = REPRO_CART_UNKNOWN;
+    }
+
+    IRQ_RESTORE(ime);
+
+    return &sCarts[type];
+}
+
+// ---------------------------------------------------------------- SRAM
+
+// Last value written to the bank register, or -1 when unknown. Avoids
+// writing the register more often than the cart's own code does.
+static s32 sBankRegister = -1;
+
+void ReproSram_ForgetBank(void)
+{
+    sBankRegister = -1;
+}
+
+void ReproSram_SelectBank(u32 bank, const u8 *bankValues)
+{
+    u8 value = bankValues[bank & 1];
+
+    if (sBankRegister != value)
+    {
+        BANK_WRITE8(value);
+        sBankRegister = value;
+    }
+}
+
+u8 ReproSram_Read8(u32 offset, const u8 *bankValues)
+{
+    ReproSram_SelectBank(offset >> 16, bankValues);
+    return SRAM_READ8(offset & 0xFFFF);
+}
+
+void ReproSram_Write8(u32 offset, u8 value, const u8 *bankValues)
+{
+    ReproSram_SelectBank(offset >> 16, bankValues);
+    SRAM_WRITE8(offset & 0xFFFF, value);
+}
+
+static u16 SramWord(u32 offset, const u8 *bankValues)
+{
+    ReproSram_SelectBank(offset >> 16, bankValues);
+    return SRAM_READ8(offset & 0xFFFF) | (SRAM_READ8((offset + 1) & 0xFFFF) << 8);
+}
+
+// ---------------------------------------------------------------- AMD
+
+static void AmdUnlock(const struct ReproCart *cart)
+{
+    ROM_WRITE16(cart->unlockAddr1, cart->unlockData1);
+    ROM_WRITE16(cart->unlockAddr2, cart->unlockData2);
+}
+
+// Waits for DQ7 of one byte lane to read 1 (erase complete), checking DQ5.
+static bool32 AmdWaitLane(u32 romOffset, u16 dq7)
+{
+    u32 polls;
+    u16 dq5 = dq7 >> 2;
+    u16 value;
+
+    for (polls = 0; polls < POLL_LIMIT; polls++)
+    {
+        value = ROM_READ16(romOffset);
+        if (value & dq7)
+            return TRUE;
+        if (value & dq5)
+            return (ROM_READ16(romOffset) & dq7) != 0;
+    }
+
+    return FALSE;
+}
+
+static u16 AmdEraseBlock(const struct ReproCart *cart, u32 romOffset)
+{
+    u16 result = REPRO_OK;
+    u16 m = cart->cmdMultiplier;
+
+    ROM_WRITE16(romOffset, 0xF0 * m);
+    AmdUnlock(cart);
+    ROM_WRITE16(cart->unlockAddr1, 0x80 * m);
+    AmdUnlock(cart);
+    ROM_WRITE16(romOffset, 0x30 * m);
+
+    if ((cart->statusMask & 0x8000) && !AmdWaitLane(romOffset, 0x8000))
+        result = REPRO_ERR_TIMEOUT;
+    if (result == REPRO_OK && (cart->statusMask & 0x0080) && !AmdWaitLane(romOffset, 0x0080))
+        result = REPRO_ERR_TIMEOUT;
+
+    ROM_WRITE16(romOffset, 0xF0 * m);
+
+    if (result == REPRO_OK && ROM_READ16(romOffset) != 0xFFFF)
+        result = REPRO_ERR_VERIFY;
+
+    return result;
+}
+
+static u16 AmdWaitProgram(u32 romOffset, u16 value)
+{
+    u32 polls;
+
+    for (polls = 0; polls < POLL_LIMIT; polls++)
+    {
+        if (ROM_READ16(romOffset) == value)
+            return REPRO_OK;
+    }
+
+    return REPRO_ERR_TIMEOUT;
+}
+
+static u16 AmdProgramWords(const struct ReproCart *cart, u32 romOffset, u32 unitOffset, u32 size)
+{
+    u16 result = REPRO_OK;
+    u16 m = cart->cmdMultiplier;
+    u32 i;
+
+    for (i = 0; i < size && result == REPRO_OK; i += 2)
+    {
+        u16 value = SramWord(unitOffset + i, cart->bankValue);
+
+        if (value == 0xFFFF)
+            continue; // erased state, nothing to program
+
+        if (cart->useBypass)
+        {
+            ROM_WRITE16(romOffset + i, 0xA0 * m);
+        }
+        else
+        {
+            AmdUnlock(cart);
+            ROM_WRITE16(cart->unlockAddr1, 0xA0 * m);
+        }
+        ROM_WRITE16(romOffset + i, value);
+        result = AmdWaitProgram(romOffset + i, value);
+    }
+
+    return result;
+}
+
+static u16 AmdProgramUnit(const struct ReproCart *cart, u32 romOffset, u32 unitOffset)
+{
+    u16 result;
+    u16 m = cart->cmdMultiplier;
+
+    if (cart->useBypass)
+    {
+        AmdUnlock(cart);
+        ROM_WRITE16(cart->unlockAddr1, 0x20 * m);
+    }
+
+    result = AmdProgramWords(cart, romOffset, unitOffset, cart->programUnit);
+
+    if (cart->useBypass)
+    {
+        // Leave unlock bypass mode.
+        ROM_WRITE16(romOffset, 0x90 * m);
+        ROM_WRITE16(romOffset, 0x00);
+    }
+    ROM_WRITE16(romOffset, 0xF0 * m);
+
+    return result;
+}
+
+// ---------------------------------------------------------------- Intel
+
+#define INTEL_SR_READY  0x80
+// Erase error, program error and VPP error. A locked block also sets one of
+// the first two. Bits 0 and 1 are left out: their meaning varies by chip and
+// they trade places on boards with D0/D1 swapped.
+#define INTEL_SR_ERRORS 0x38
+
+static u16 IntelWaitReady(u32 romOffset)
+{
+    u32 polls;
+    u8 status;
+
+    for (polls = 0; polls < POLL_LIMIT; polls++)
+    {
+        status = ROM_READ16(romOffset);
+        if (status & INTEL_SR_READY)
+        {
+            if (status & INTEL_SR_ERRORS)
+            {
+                ROM_WRITE16(romOffset, 0x50); // clear status
+                return REPRO_ERR_STATUS;
+            }
+            return REPRO_OK;
+        }
+    }
+
+    return REPRO_ERR_TIMEOUT;
+}
+
+static u16 IntelEraseBlock(u32 romOffset)
+{
+    u16 result;
+    u32 polls;
+
+    // Unlock the block, then wait until its lock bits read clear.
+    ROM_WRITE16(romOffset, 0xFF);
+    ROM_WRITE16(romOffset, 0x50);
+    ROM_WRITE16(romOffset, 0x60);
+    ROM_WRITE16(romOffset, 0xD0);
+    ROM_WRITE16(romOffset, 0x90);
+    for (polls = 0; polls < POLL_LIMIT; polls++)
+    {
+        if ((ROM_READ16(romOffset + 2) & 3) == 0)
+            break;
+    }
+    ROM_WRITE16(romOffset, 0xFF);
+    if (polls == POLL_LIMIT)
+        return REPRO_ERR_LOCKED;
+
+    ROM_WRITE16(romOffset, 0x20);
+    ROM_WRITE16(romOffset, 0xD0);
+    result = IntelWaitReady(romOffset);
+    ROM_WRITE16(romOffset, 0xFF);
+
+    if (result == REPRO_OK && ROM_READ16(romOffset) != 0xFFFF)
+        result = REPRO_ERR_VERIFY;
+
+    return result;
+}
+
+static u16 IntelProgramUnit(const struct ReproCart *cart, u32 romOffset, u32 unitOffset)
+{
+    u16 result = REPRO_OK;
+    u32 i;
+
+    if (cart->type == REPRO_CART_INTEL_BUFFERED)
+    {
+        u32 words = cart->programUnit / 2;
+
+        // Same sequence as the cart's own code: wait ready, buffer command,
+        // word count - 1, data, confirm at the last address.
+        ROM_WRITE16(romOffset, 0xFF);
+        ROM_WRITE16(romOffset, 0x70);
+        result = IntelWaitReady(romOffset);
+        ROM_WRITE16(romOffset, 0xFF);
+        if (result != REPRO_OK)
+            return result;
+        ROM_WRITE16(romOffset, cart->bufferCmd);
+        ROM_WRITE16(romOffset, words - 1);
+        for (i = 0; i < words; i++)
+            ROM_WRITE16(romOffset + i * 2, SramWord(unitOffset + i * 2, cart->bankValue));
+        ROM_WRITE16(romOffset + (words - 1) * 2, 0xD0);
+        result = IntelWaitReady(romOffset + (words - 1) * 2);
+        ROM_WRITE16(romOffset, 0xFF);
+        return result;
+    }
+
+    for (i = 0; i < cart->programUnit && result == REPRO_OK; i += 2)
+    {
+        u16 value = SramWord(unitOffset + i, cart->bankValue);
+
+        if (value == 0xFFFF)
+            continue;
+
+        ROM_WRITE16(romOffset + i, 0xFF);
+        ROM_WRITE16(romOffset + i, 0x70);
+        result = IntelWaitReady(romOffset + i);
+        ROM_WRITE16(romOffset + i, 0xFF);
+        if (result != REPRO_OK)
+            break;
+        ROM_WRITE16(romOffset + i, 0x40);
+        ROM_WRITE16(romOffset + i, value);
+        result = IntelWaitReady(romOffset + i);
+        ROM_WRITE16(romOffset + i, 0xFF);
+    }
+
+    return result;
+}
+
+// ---------------------------------------------------------------- dispatch
+
+u16 ReproCart_EraseBlock(const struct ReproCart *cart, u32 romOffset)
+{
+    u16 ime;
+    u16 result;
+
+    if (!cart->supported)
+        return REPRO_ERR_UNSUPPORTED;
+
+    IRQ_DISABLE(ime);
+    if (IsIntel(cart))
+        result = IntelEraseBlock(romOffset);
+    else
+        result = AmdEraseBlock(cart, romOffset);
+    IRQ_RESTORE(ime);
+
+    return result;
+}
+
+u16 ReproCart_ProgramUnit(const struct ReproCart *cart, u32 romOffset, u32 unitOffset)
+{
+    u16 ime;
+    u16 result;
+
+    if (!cart->supported)
+        return REPRO_ERR_UNSUPPORTED;
+
+    IRQ_DISABLE(ime);
+    if (IsIntel(cart))
+        result = IntelProgramUnit(cart, romOffset, unitOffset);
+    else
+        result = AmdProgramUnit(cart, romOffset, unitOffset);
+    IRQ_RESTORE(ime);
+
+    return result;
+}
diff --git a/payload/src/repro/repro_flash.c b/payload/src/repro/repro_flash.c
new file mode 100644
index 0000000..389432f
--- /dev/null
+++ b/payload/src/repro/repro_flash.c
@@ -0,0 +1,219 @@
+// AgbFlash backend for batteryless repro carts (see include/repro_flash.h).
+//
+// Reads come straight from the save area in cart ROM until the first write.
+// The first write identifies the board, copies the save area into the cart's
+// banked SRAM and from then on the AgbFlash API works on that copy.
+// ReproFlash_Commit writes the copy back to ROM; the link code calls it at
+// the end of each phase of a save, before reporting the result.
+
+#include "gba/gba.h"
+#include "gba/flash_internal.h"
+#include "repro_flash.h"
+#include "repro_cart.h"
+#include "repro_image.h"
+
+#define SESSION_NONE   0
+#define SESSION_READY  1
+#define SESSION_FAILED 2
+
+u8 gReproActive = FALSE;
+u32 gReproSaveOffset = 0;
+u8 gReproSession = SESSION_NONE;
+u8 gReproCartType = REPRO_CART_UNKNOWN;
+u16 gReproLastError = 0;
+
+static const u16 sReproMaxTime[] =
+{
+    10, 65469, TIMER_ENABLE | TIMER_INTR_ENABLE | TIMER_256CLK,
+    10, 65469, TIMER_ENABLE | TIMER_INTR_ENABLE | TIMER_256CLK,
+    2000, 65469, TIMER_ENABLE | TIMER_INTR_ENABLE | TIMER_256CLK,
+    2000, 65469, TIMER_ENABLE | TIMER_INTR_ENABLE | TIMER_256CLK,
+};
+
+// Same geometry as the 128 KiB flash chips, so save.c needs no changes.
+static const struct FlashType sReproFlashType =
+{
+    131072, // ROM size
+    {
+        4096, // sector size
+          12, // bit shift to multiply by sector size (4096 == 1 << 12)
+          32, // number of sectors
+           0  // appears to be unused
+    },
+    { 3, 1 }, // wait state setup data
+    { { 0x00, 0x00 } } // no chip ID
+};
+
+static bool32 InRange(u16 sectorNum, u32 offset, u32 size)
+{
+    return sectorNum < REPRO_NUM_SECTORS && offset <= REPRO_SECTOR_SIZE && size <= REPRO_SECTOR_SIZE - offset;
+}
+
+static u32 ImageOffset(u16 sectorNum, u32 offset)
+{
+    return ((u32)sectorNum << 12) + offset;
+}
+
+static const vu8 *RomPtr(u16 sectorNum, u32 offset)
+{
+    return (const vu8 *)(REPRO_ROM_START + gReproSaveOffset + ImageOffset(sectorNum, offset));
+}
+
+static bool32 BeginWriteSession(void)
+{
+    const struct ReproCart *cart;
+    u16 result;
+
+    if (gReproSession == SESSION_READY)
+        return TRUE;
+    if (gReproSession == SESSION_FAILED)
+        return FALSE;
+
+    cart = ReproCart_Probe();
+    gReproCartType = cart->type;
+
+    if (!cart->supported)
+        result = REPRO_ERR_UNSUPPORTED;
+    else
+        result = ReproImage_Load(gReproSaveOffset);
+
+    if (result != REPRO_OK)
+    {
+        gReproLastError = result;
+        gReproSession = SESSION_FAILED;
+        return FALSE;
+    }
+
+    gReproSession = SESSION_READY;
+    return TRUE;
+}
+
+void ReproFlash_Read(u16 sectorNum, u32 offset, u8 *dest, u32 size)
+{
+    const vu8 *src;
+
+    if (!InRange(sectorNum, offset, size))
+        return;
+
+    if (gReproSession == SESSION_READY)
+    {
+        ReproImage_Read(ImageOffset(sectorNum, offset), dest, size);
+        return;
+    }
+
+    src = RomPtr(sectorNum, offset);
+    while (size-- != 0)
+        *dest++ = *src++;
+}
+
+// Returns 0 when equal, otherwise nonzero (like VerifyFlashSector).
+u32 ReproFlash_Verify(u16 sectorNum, const u8 *src, u32 size)
+{
+    const vu8 *tgt;
+
+    if (!InRange(sectorNum, 0, size))
+        return REPRO_ERR_RANGE;
+
+    if (gReproSession == SESSION_READY)
+        return ReproImage_Compare(ImageOffset(sectorNum, 0), src, size);
+
+    tgt = RomPtr(sectorNum, 0);
+    while (size-- != 0)
+    {
+        if (*tgt++ != *src++)
+            return (u32)(tgt - 1);
+    }
+
+    return 0;
+}
+
+u16 ReproFlash_ProgramByte(u16 sectorNum, u32 offset, u8 data)
+{
+    if (!InRange(sectorNum, offset, 1))
+        return REPRO_ERR_RANGE;
+    if (!BeginWriteSession())
+        return REPRO_ERR_READ_ONLY;
+
+    ReproImage_Write(ImageOffset(sectorNum, offset), &data, 1);
+    return 0;
+}
+
+u16 ReproFlash_ProgramSector(u16 sectorNum, void *src)
+{
+    if (!InRange(sectorNum, 0, REPRO_SECTOR_SIZE))
+        return REPRO_ERR_RANGE;
+    if (!BeginWriteSession())
+        return REPRO_ERR_READ_ONLY;
+
+    ReproImage_Write(ImageOffset(sectorNum, 0), src, REPRO_SECTOR_SIZE);
+    return 0;
+}
+
+u16 ReproFlash_EraseSector(u16 sectorNum)
+{
+    if (!InRange(sectorNum, 0, REPRO_SECTOR_SIZE))
+        return REPRO_ERR_RANGE;
+    if (!BeginWriteSession())
+        return REPRO_ERR_READ_ONLY;
+
+    ReproImage_Fill(ImageOffset(sectorNum, 0), 0xFF, REPRO_SECTOR_SIZE);
+    return 0;
+}
+
+u16 ReproFlash_EraseChip(void)
+{
+    u16 i;
+
+    if (!BeginWriteSession())
+        return REPRO_ERR_READ_ONLY;
+
+    for (i = 0; i < REPRO_NUM_SECTORS; i++)
+        ReproImage_Fill(ImageOffset(i, 0), 0xFF, REPRO_SECTOR_SIZE);
+    return 0;
+}
+
+u16 ReproFlash_WaitForWrite(u8 phase, u8 *addr, u8 lastData)
+{
+    return 0;
+}
+
+// Writes the working copy back to cart ROM. Returns 0 on success.
+u16 ReproFlash_Commit(void)
+{
+    u16 result;
+
+    if (!gReproActive || gReproSession != SESSION_READY)
+        return 0;
+
+    result = ReproImage_Commit(ReproCart_Get(gReproCartType), gReproSaveOffset);
+    if (result != REPRO_OK)
+        gReproLastError = result;
+
+    return result;
+}
+
+// Called by IdentifyFlash before probing for a real flash chip.
+bool32 ReproFlash_Detect(void)
+{
+    struct ReproScanResult result;
+    const u8 *rom = (const u8 *)REPRO_ROM_START;
+
+    gReproActive = FALSE;
+    gReproSession = SESSION_NONE;
+
+    if (!ReproScanForSave(rom, ReproGetRomSize(rom), &result))
+        return FALSE;
+
+    gReproSaveOffset = result.saveOffset;
+    gReproActive = TRUE;
+
+    ProgramFlashByte = ReproFlash_ProgramByte;
+    ProgramFlashSector = ReproFlash_ProgramSector;
+    EraseFlashChip = ReproFlash_EraseChip;
+    EraseFlashSector = ReproFlash_EraseSector;
+    WaitForFlashWrite = ReproFlash_WaitForWrite;
+    gFlashMaxTime = sReproMaxTime;
+    gFlash = &sReproFlashType;
+
+    return TRUE;
+}
diff --git a/payload/src/repro/repro_image.c b/payload/src/repro/repro_image.c
new file mode 100644
index 0000000..157e25f
--- /dev/null
+++ b/payload/src/repro/repro_image.c
@@ -0,0 +1,339 @@
+// SRAM working copy of the save and the commit to ROM.
+//
+// The cart's own boot code copies the ROM save area into SRAM at power-on,
+// and its save routine writes SRAM back to ROM. This file does the same for
+// the link program: the AgbFlash API edits the SRAM copy, and a commit
+// writes the difference back to the cart's ROM flash.
+//
+// A commit never programs a unit that already holds data: it either
+// programs units that are still erased, or erases the whole save area and
+// reprograms it. The 4 KiB sector whose signature is still pending (the
+// first phase of the link save) is left erased around its signature until
+// the second phase sets the signature, so phase two only programs erased
+// flash. This keeps every chip type safe, including ones that cannot be
+// reprogrammed without an erase.
+
+#include "repro_types.h"
+#include "repro_hw.h"
+#include "repro_cart.h"
+#include "repro_flash.h"
+#include "repro_image.h"
+
+#define SECTORS_PER_SLOT 14
+
+static const u8 sBootBanks[2] = {REPRO_BOOT_BANK0, REPRO_BOOT_BANK1};
+
+// Bank register values in use: the boot code's values while the link program
+// edits the image, the board's flush values during a commit (as the cart's
+// own code does).
+static const u8 *sBanks = sBootBanks;
+
+// ---------------------------------------------------------------- image access
+
+static void SelectBank(u32 offset)
+{
+    ReproSram_SelectBank(offset >> 16, sBanks);
+}
+
+// Reads within one bank (callers never cross a 64 KiB boundary).
+static u8 ImageByte(u32 offset)
+{
+    return SRAM_READ8(offset & 0xFFFF);
+}
+
+static u16 ImageWord(u32 offset)
+{
+    return ImageByte(offset) | (ImageByte(offset + 1) << 8);
+}
+
+u16 ReproImage_Load(u32 saveOffset)
+{
+    u32 bank, i;
+
+    ReproSram_ForgetBank();
+    sBanks = sBootBanks;
+
+    // The two banks must be independent 64 KiB pages.
+    ReproSram_Write8(0x00000, 0xA5, sBootBanks);
+    ReproSram_Write8(0x10000, 0x5A, sBootBanks);
+    if (ReproSram_Read8(0x00000, sBootBanks) != 0xA5 || ReproSram_Read8(0x10000, sBootBanks) != 0x5A)
+        return REPRO_ERR_SRAM;
+
+    for (bank = 0; bank < 2; bank++)
+    {
+        u32 base = bank << 16;
+
+        ReproSram_SelectBank(bank, sBootBanks);
+        for (i = 0; i < REPRO_SRAM_BANK_SIZE; i += 2)
+        {
+            u16 word = ROM_READ16(saveOffset + base + i);
+            SRAM_WRITE8(i, word);
+            SRAM_WRITE8(i + 1, word >> 8);
+        }
+        for (i = 0; i < REPRO_SRAM_BANK_SIZE; i += 2)
+        {
+            u16 word = ROM_READ16(saveOffset + base + i);
+            if (SRAM_READ8(i) != (u8)word || SRAM_READ8(i + 1) != (u8)(word >> 8))
+                return REPRO_ERR_SRAM;
+        }
+    }
+
+    ReproSram_SelectBank(0, sBootBanks);
+    return REPRO_OK;
+}
+
+void ReproImage_Read(u32 offset, u8 *dest, u32 size)
+{
+    SelectBank(offset);
+    while (size-- != 0)
+        *dest++ = ImageByte(offset++);
+}
+
+// Returns 0 when equal, otherwise 1 + the index of the first difference.
+u32 ReproImage_Compare(u32 offset, const u8 *src, u32 size)
+{
+    u32 i;
+
+    SelectBank(offset);
+    for (i = 0; i < size; i++)
+    {
+        if (ImageByte(offset + i) != src[i])
+            return i + 1;
+    }
+
+    return 0;
+}
+
+void ReproImage_Write(u32 offset, const u8 *src, u32 size)
+{
+    SelectBank(offset);
+    while (size-- != 0)
+        SRAM_WRITE8((offset++) & 0xFFFF, *src++);
+}
+
+void ReproImage_Fill(u32 offset, u8 value, u32 size)
+{
+    SelectBank(offset);
+    while (size-- != 0)
+        SRAM_WRITE8((offset++) & 0xFFFF, value);
+}
+
+// ---------------------------------------------------------------- commit
+
+#define UNIT_SAME        0
+#define UNIT_PROGRAM     1 // ROM unit erased, image unit has data
+#define UNIT_NEEDS_ERASE 2
+
+#define FOOTER_ID        0xFF4
+#define FOOTER_SIGNATURE 0xFF8
+#define FOOTER_COUNTER   0xFFC
+
+// First phase of a link save: the whole slot is written except the first
+// byte of one signature, which stays 0xFF until the second phase.
+static bool32 IsPendingSignature(u32 sigOffset)
+{
+    return ImageByte(sigOffset) == 0xFF
+        && ImageByte(sigOffset + 1) == 0x20
+        && ImageByte(sigOffset + 2) == 0x01
+        && ImageByte(sigOffset + 3) == 0x08;
+}
+
+// Bank must already be selected for 'unit'.
+static bool32 UnitIsDeferred(const struct ReproCart *cart, u32 unit)
+{
+    u32 sigOffset = (unit & ~(REPRO_SECTOR_SIZE - 1)) + FOOTER_SIGNATURE;
+
+    if (sigOffset < unit || sigOffset >= unit + cart->programUnit)
+        return FALSE;
+
+    return IsPendingSignature(sigOffset);
+}
+
+static u32 ClassifyUnit(const struct ReproCart *cart, u32 saveOffset, u32 unit, bool32 deferred)
+{
+    u32 i;
+    bool32 romErased = TRUE;
+    bool32 differs = FALSE;
+
+    for (i = 0; i < cart->programUnit; i += 2)
+    {
+        u16 rom = ROM_READ16(saveOffset + unit + i);
+        u16 want = deferred ? 0xFFFF : ImageWord(unit + i);
+
+        if (rom != 0xFFFF)
+            romErased = FALSE;
+        if (rom != want)
+            differs = TRUE;
+    }
+
+    if (!differs)
+        return UNIT_SAME;
+
+    return romErased ? UNIT_PROGRAM : UNIT_NEEDS_ERASE;
+}
+
+static bool32 UnitIsBlank(const struct ReproCart *cart, u32 unit)
+{
+    u32 i;
+
+    for (i = 0; i < cart->programUnit; i += 2)
+    {
+        if (ImageWord(unit + i) != 0xFFFF)
+            return FALSE;
+    }
+
+    return TRUE;
+}
+
+// Save counter of a complete slot in the image, or -1.
+static s32 SlotCounter(u32 firstSector)
+{
+    u32 i;
+    u32 idsSeen = 0;
+    u32 counter = 0;
+
+    for (i = 0; i < SECTORS_PER_SLOT; i++)
+    {
+        u32 sector = (firstSector + i) * REPRO_SECTOR_SIZE;
+        u32 sig, sectorCounter;
+
+        SelectBank(sector);
+        sig = ImageWord(sector + FOOTER_SIGNATURE) | ((u32)ImageWord(sector + FOOTER_SIGNATURE + 2) << 16);
+        if (sig != REPRO_SIGNATURE)
+            return -1;
+        sectorCounter = ImageWord(sector + FOOTER_COUNTER) | ((u32)ImageWord(sector + FOOTER_COUNTER + 2) << 16);
+        if (i == 0)
+            counter = sectorCounter;
+        else if (sectorCounter != counter)
+            return -1;
+        idsSeen |= 1 << (ImageWord(sector + FOOTER_ID) & 0x1F);
+    }
+
+    if (idsSeen != (1 << SECTORS_PER_SLOT) - 1)
+        return -1;
+
+    return counter & 0x7FFFFFFF;
+}
+
+// Sector order for a full rewrite: the newest complete slot first, so that a
+// valid save exists in ROM again as early as possible.
+static void GetSectorOrder(u8 *order)
+{
+    s32 counterA = SlotCounter(0);
+    s32 counterB = SlotCounter(SECTORS_PER_SLOT);
+    u32 first = (counterB > counterA) ? SECTORS_PER_SLOT : 0;
+    u32 second = SECTORS_PER_SLOT - first;
+    u32 i, n = 0;
+
+    for (i = 0; i < SECTORS_PER_SLOT; i++)
+        order[n++] = first + i;
+    for (i = 0; i < SECTORS_PER_SLOT; i++)
+        order[n++] = second + i;
+    for (i = SECTORS_PER_SLOT * 2; i < REPRO_NUM_SECTORS; i++)
+        order[n++] = i;
+}
+
+// Programs every unit of one sector that should hold data.
+static u16 ProgramSector(const struct ReproCart *cart, u32 saveOffset, u32 sector, bool32 afterErase)
+{
+    u32 unit;
+    u32 start = sector * REPRO_SECTOR_SIZE;
+    u16 result = REPRO_OK;
+
+    for (unit = start; unit < start + REPRO_SECTOR_SIZE && result == REPRO_OK; unit += cart->programUnit)
+    {
+        bool32 deferred;
+        bool32 program;
+
+        SelectBank(unit);
+        deferred = UnitIsDeferred(cart, unit);
+        if (deferred)
+            continue;
+
+        if (afterErase)
+            program = !UnitIsBlank(cart, unit);
+        else
+            program = ClassifyUnit(cart, saveOffset, unit, FALSE) == UNIT_PROGRAM;
+
+        if (program)
+            result = ReproCart_ProgramUnit(cart, saveOffset + unit, unit);
+    }
+
+    return result;
+}
+
+static u16 VerifyAll(const struct ReproCart *cart, u32 saveOffset)
+{
+    u32 unit;
+
+    for (unit = 0; unit < REPRO_SAVE_SIZE; unit += cart->programUnit)
+    {
+        SelectBank(unit);
+        if (ClassifyUnit(cart, saveOffset, unit, UnitIsDeferred(cart, unit)) != UNIT_SAME)
+            return REPRO_ERR_VERIFY;
+    }
+
+    return REPRO_OK;
+}
+
+u16 ReproImage_Commit(const struct ReproCart *cart, u32 saveOffset)
+{
+    u32 unit, i, attempt;
+    bool32 needErase = FALSE;
+    bool32 anyChange = FALSE;
+    u16 result = REPRO_OK;
+    u8 order[REPRO_NUM_SECTORS];
+
+    if (!cart->supported)
+        return REPRO_ERR_UNSUPPORTED;
+
+    sBanks = cart->bankValue;
+
+    for (unit = 0; unit < REPRO_SAVE_SIZE; unit += cart->programUnit)
+    {
+        u32 status;
+
+        SelectBank(unit);
+        status = ClassifyUnit(cart, saveOffset, unit, UnitIsDeferred(cart, unit));
+        if (status != UNIT_SAME)
+            anyChange = TRUE;
+        if (status == UNIT_NEEDS_ERASE)
+            needErase = TRUE;
+    }
+
+    if (!anyChange)
+        goto done;
+
+    GetSectorOrder(order);
+
+    for (attempt = 0; attempt < 2; attempt++)
+    {
+        result = REPRO_OK;
+
+        if (needErase)
+        {
+            for (i = 0; i < REPRO_SAVE_SIZE && result == REPRO_OK; i += cart->eraseStride)
+                result = ReproCart_EraseBlock(cart, saveOffset + i);
+        }
+
+        for (i = 0; i < REPRO_NUM_SECTORS && result == REPRO_OK; i++)
+            result = ProgramSector(cart, saveOffset, order[i], needErase);
+
+        if (result == REPRO_OK)
+            result = VerifyAll(cart, saveOffset);
+
+        if (result == REPRO_OK)
+            break;
+
+        // Retry once from a clean erase.
+        needErase = TRUE;
+    }
+
+    ReproCart_ReadArrayMode(cart);
+
+done:
+    sBanks = sBootBanks;
+    SelectBank(0);
+
+    return result;
+}
diff --git a/payload/src/repro/repro_scan.c b/payload/src/repro/repro_scan.c
new file mode 100644
index 0000000..1c7197e
--- /dev/null
+++ b/payload/src/repro/repro_scan.c
@@ -0,0 +1,154 @@
+// Locates a FLASH1M-format Pokémon save inside cart ROM.
+// This file has no hardware access so it can also be compiled on the host
+// (REPRO_HOST_TEST) and tested against real ROM dumps.
+
+#include "repro_types.h"
+#include "repro_flash.h"
+
+#define SECTORS_PER_SLOT 14
+
+#define SLOT_EMPTY    0
+#define SLOT_COMPLETE 1
+#define SLOT_PARTIAL  2
+
+// Sector footer layout (see struct SaveSector in libpmagb/save.c)
+#define FOOTER_ID        0xFF4
+#define FOOTER_SIGNATURE 0xFF8
+#define FOOTER_COUNTER   0xFFC
+
+static u16 RomRead16(const u8 *rom, u32 offset)
+{
+    return *(const vu16 *)(rom + offset);
+}
+
+static u32 RomRead32(const u8 *rom, u32 offset)
+{
+    return (u32)RomRead16(rom, offset) | ((u32)RomRead16(rom, offset + 2) << 16);
+}
+
+// A slot is complete when all 14 sectors carry the signature, their ids are
+// exactly 0..13 and they share one save counter.
+static u32 CheckSlot(const u8 *rom, u32 slotStart, u32 *counterOut)
+{
+    u32 i;
+    u32 idsSeen = 0;
+    u32 numSigned = 0;
+    u32 counter = 0;
+    bool32 countersMatch = TRUE;
+
+    for (i = 0; i < SECTORS_PER_SLOT; i++)
+    {
+        u32 sector = slotStart + i * REPRO_SECTOR_SIZE;
+
+        if (RomRead32(rom, sector + FOOTER_SIGNATURE) == REPRO_SIGNATURE)
+        {
+            u32 id = RomRead16(rom, sector + FOOTER_ID);
+            u32 sectorCounter = RomRead32(rom, sector + FOOTER_COUNTER);
+
+            if (numSigned == 0)
+                counter = sectorCounter;
+            else if (sectorCounter != counter)
+                countersMatch = FALSE;
+
+            if (id < SECTORS_PER_SLOT)
+                idsSeen |= 1 << id;
+
+            numSigned++;
+        }
+    }
+
+    if (numSigned == 0)
+        return SLOT_EMPTY;
+
+    if (numSigned == SECTORS_PER_SLOT && idsSeen == (1 << SECTORS_PER_SLOT) - 1 && countersMatch)
+    {
+        *counterOut = counter;
+        return SLOT_COMPLETE;
+    }
+
+    return SLOT_PARTIAL;
+}
+
+// True when [half, 2*half) reads back the same as [0, half) at a spread of
+// sample points, meaning the chip is not larger than 'half'.
+static bool32 IsMirror(const u8 *rom, u32 half)
+{
+    u32 i;
+
+    // The cart header is never blank, so a blank upper half fails here.
+    for (i = 0; i < 0xC0; i += 2)
+    {
+        if (RomRead16(rom, i) != RomRead16(rom, half + i))
+            return FALSE;
+    }
+
+    for (i = 1; i < 64; i++)
+    {
+        u32 offset = i * (half / 64) + 0x1F2;
+
+        if (RomRead16(rom, offset) != RomRead16(rom, half + offset))
+            return FALSE;
+    }
+
+    return TRUE;
+}
+
+// Readable size of cart ROM: 32 MiB, reduced while the upper half mirrors the lower.
+u32 ReproGetRomSize(const u8 *rom)
+{
+    u32 size = REPRO_ROM_MAX_SIZE;
+
+    while (size > 0x400000 && IsMirror(rom, size / 2))
+        size /= 2;
+
+    return size;
+}
+
+bool32 ReproScanForSave(const u8 *rom, u32 romSize, struct ReproScanResult *result)
+{
+    u32 base;
+    bool32 found = FALSE;
+
+    result->saveOffset = 0;
+    result->newestCounter = 0;
+    result->numCandidates = 0;
+    result->completeSlots = 0;
+
+    for (base = 0; base + REPRO_SAVE_SIZE <= romSize; base += REPRO_SCAN_STEP)
+    {
+        u32 counterA = 0;
+        u32 counterB = 0;
+        u32 slotA = CheckSlot(rom, base, &counterA);
+        u32 slotB = CheckSlot(rom, base + SECTORS_PER_SLOT * REPRO_SECTOR_SIZE, &counterB);
+        u32 newest;
+        u8 completeSlots = 0;
+
+        if (slotA == SLOT_COMPLETE)
+            completeSlots |= 1;
+        if (slotB == SLOT_COMPLETE)
+            completeSlots |= 2;
+
+        if (completeSlots == 0)
+            continue;
+
+        if (completeSlots == 3)
+            newest = (counterA > counterB) ? counterA : counterB;
+        else if (completeSlots == 1)
+            newest = counterA;
+        else
+            newest = counterB;
+
+        result->numCandidates++;
+
+        // With several candidates keep the most recent save.
+        if (!found || newest > result->newestCounter)
+        {
+            result->saveOffset = base;
+            result->newestCounter = newest;
+            result->completeSlots = completeSlots;
+            found = TRUE;
+        }
+    }
+
+    return found;
+}
