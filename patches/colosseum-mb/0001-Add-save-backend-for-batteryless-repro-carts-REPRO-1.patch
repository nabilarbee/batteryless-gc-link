+#ifdef REPRO_SAVE
+    // A save image inside cart ROM means a batteryless repro cart.
+    if (ReproFlash_Detect())
+        return 0;
+#endif
+
     REG_WAITCNT = (REG_WAITCNT & ~WAITCNT_SRAM_MASK) | WAITCNT_SRAM_8;
 
     flashId = ReadFlashId();
