diff --git a/payload/include/repro_cart.h b/payload/include/repro_cart.h
new file mode 100644
index 0000000..31f8ed4
--- /dev/null
+++ b/payload/include/repro_cart.h
@@ -0,0 +1,68 @@
+#ifndef GUARD_REPRO_CART_H
+#define GUARD_REPRO_CART_H
+
+// Board and flash chip handling for bootleg "batteryless" Pokémon carts.
+//
+// These carts keep a 128 KiB working copy of the save in banked SRAM
+// (bank selected by a byte write to 0x09000000) and persist it to a 128 KiB
+// area of the ROM flash chip. The board types, probe order, bank values and
+// chip command sequences below mirror the batteryless code found on the
+// AliExpress carts (as extracted by DanOl98's pkmn_gba_batteryless_patcher).
+
+#include "repro_types.h"
+
+enum
+{
+    REPRO_CART_UNKNOWN,
+    REPRO_CART_INTEL_BUFFERED, // Intel command set, 1 KiB buffered programming (cmd 0xEA)
+    REPRO_CART_INTEL_WORD,     // Intel command set, word programming (cmd 0x40)
+    REPRO_CART_AMD_SWAPPED,    // AMD command set, x16, data lines D0/D1 swapped
+    REPRO_CART_AMD_DUAL,       // AMD command set, two x8 chips side by side
+    REPRO_CART_AMD_X16,        // AMD command set, x16 (the cart's own code saves only 64 KiB)
+    REPRO_CART_TYPE_COUNT
+};
+
+struct ReproCart
+{
+    u8 type;
+    u8 bankValue[2];    // values written to 0x09000000 by the flush routine
+    u8 supported;       // FALSE when writes are refused for this board type
+    u32 eraseStride;    // erase commands are issued every eraseStride bytes of the save area
+    u32 programUnit;    // bytes programmed per program operation (2 or 1024)
+    u32 unlockAddr1;    // AMD: byte offsets from the start of ROM
+    u32 unlockAddr2;
+    u16 unlockData1;
+    u16 unlockData2;
+    u16 cmdMultiplier;  // AMD: 0x0001 for one chip, 0x0101 to send a command to both lanes
+    u16 statusMask;     // AMD: DQ7 bits checked when polling an erase
+    u8 useBypass;       // AMD: program with unlock bypass
+    u8 bufferCmd;       // Intel buffered: buffer program command
+};
+
+// Values the cart's own boot code uses to select SRAM banks 0 and 1.
+#define REPRO_BOOT_BANK0 0
+#define REPRO_BOOT_BANK1 1
+
+#define REPRO_OK              0
+#define REPRO_ERR_TIMEOUT     0x8101
+#define REPRO_ERR_STATUS      0x8102
+#define REPRO_ERR_VERIFY      0x8103
+#define REPRO_ERR_UNSUPPORTED 0x8104
+#define REPRO_ERR_SRAM        0x8105
+#define REPRO_ERR_LOCKED      0x8106
+
+const struct ReproCart *ReproCart_Probe(void);
+const struct ReproCart *ReproCart_Get(u8 type);
+u16 ReproCart_EraseBlock(const struct ReproCart *cart, u32 romOffset);
+// Programs cart->programUnit bytes at romOffset; 'unitOffset' is the
+// position of that unit inside the 128 KiB SRAM working copy.
+u16 ReproCart_ProgramUnit(const struct ReproCart *cart, u32 romOffset, u32 unitOffset);
+void ReproCart_ReadArrayMode(const struct ReproCart *cart);
+
+// SRAM working copy (128 KiB in two 64 KiB banks)
+void ReproSram_ForgetBank(void);
+void ReproSram_SelectBank(u32 bank, const u8 *bankValues);
+u8 ReproSram_Read8(u32 offset, const u8 *bankValues);
+void ReproSram_Write8(u32 offset, u8 value, const u8 *bankValues);
+
+#endif // GUARD_REPRO_CART_H
diff --git a/payload/include/repro_flash.h b/payload/include/repro_flash.h
new file mode 100644
index 0000000..7a74c40
--- /dev/null
+++ b/payload/include/repro_flash.h
@@ -0,0 +1,62 @@
+#ifndef GUARD_REPRO_FLASH_H
+#define GUARD_REPRO_FLASH_H
+
+// Save backend for batteryless repro carts.
+//
+// Repro carts have no 128 KiB flash save chip. Their game keeps the save as
+// a normal FLASH1M image (32 sectors of 4 KiB) inside the cart's ROM flash.
+// This backend finds that image in ROM and serves the AgbFlash API from it,
+// so libpmagb/save.c works unchanged.
+
+#include "repro_types.h"
+
+#define REPRO_SECTOR_SIZE   0x1000
+#define REPRO_NUM_SECTORS   32
+#define REPRO_SAVE_SIZE     (REPRO_SECTOR_SIZE * REPRO_NUM_SECTORS)
+
+#define REPRO_ROM_START     0x08000000
+#define REPRO_ROM_MAX_SIZE  0x02000000
+
+// The save area is expected on a 64 KiB boundary, which is the erase-block
+// alignment every known repro batteryless patch uses.
+#define REPRO_SCAN_STEP     0x10000
+
+#define REPRO_SIGNATURE     0x08012025
+
+// Error codes returned through the AgbFlash API. Any nonzero value is a failure.
+#define REPRO_ERR_READ_ONLY 0x80FE
+#define REPRO_ERR_RANGE     0x80FF
+
+// Result of ReproScanForSave
+struct ReproScanResult
+{
+    u32 saveOffset;     // offset of the save area from the start of cart ROM
+    u32 newestCounter;  // highest save counter of a complete slot
+    u8 numCandidates;   // distinct (non-mirror) save areas found
+    u8 completeSlots;   // bit 0: slot A complete, bit 1: slot B complete
+};
+
+extern u8 gReproActive;     // nonzero while the save is served from cart ROM
+extern u32 gReproSaveOffset;
+extern u8 gReproSession;    // 0 = reading ROM, 1 = SRAM working copy ready, 2 = writes refused
+extern u8 gReproCartType;   // REPRO_CART_* from repro_cart.h
+extern u16 gReproLastError;
+
+// Core scan, also built on the host for tests.
+// 'rom' points at the first byte of cart ROM, 'romSize' is the readable size.
+bool32 ReproScanForSave(const u8 *rom, u32 romSize, struct ReproScanResult *result);
+u32 ReproGetRomSize(const u8 *rom);
+
+#ifndef REPRO_HOST_TEST
+bool32 ReproFlash_Detect(void);
+void ReproFlash_Read(u16 sectorNum, u32 offset, u8 *dest, u32 size);
+u32 ReproFlash_Verify(u16 sectorNum, const u8 *src, u32 size);
+u16 ReproFlash_ProgramByte(u16 sectorNum, u32 offset, u8 data);
+u16 ReproFlash_ProgramSector(u16 sectorNum, void *src);
+u16 ReproFlash_EraseSector(u16 sectorNum);
+u16 ReproFlash_EraseChip(void);
+u16 ReproFlash_WaitForWrite(u8 phase, u8 *addr, u8 lastData);
+u16 ReproFlash_Commit(void);
+#endif
+
+#endif // GUARD_REPRO_FLASH_H
diff --git a/payload/include/repro_hw.h b/payload/include/repro_hw.h
