diff --git a/repro_tools/xdlink/linkhook.c b/repro_tools/xdlink/linkhook.c
new file mode 100644
index 0000000..2bd70b8
--- /dev/null
+++ b/repro_tools/xdlink/linkhook.c
@@ -0,0 +1,131 @@
+// Emerald's link hook, in free cart ROM.
+//
+// On the copyright screen Emerald receives a program from the GameCube and
+// runs it. Originally it swapped in its own Colosseum program when the
+// received one had Colosseum's game code; the flasher changes that code to a
+// call to LinkHook, which does the same swap and also prepares XD's programs:
+//
+//  1. LinkHook (before the program runs): when the received program is one of
+//     XD's link programs, its loader is changed to jump to XdPostLoad instead
+//     of the decompressed program.
+//  2. XdPostLoad (after the loader has decompressed the program): checks the
+//     result, copies the shim (xd_shim.c and the repro backend) to EWRAM,
+//     redirects the program's flash and save calls to it and starts the
+//     program.
+//
+// Anything that does not match exactly is left alone and runs as before.
+
+#include "repro_types.h"
+#include "xd_link.h"
+#include "shim_syms.h"
+
+#define EWRAM               0x02000000
+#define GAME_CODE           (*(vu32 *)(EWRAM + 0xAC))
+#define COLOSSEUM_GAME_CODE 0x65366347  // "Gc6e"
+#define XD_GAME_CODE        0x54534554  // "TEST"
+#define HASH_BASIS          0x811C9DC5
+#define MARK_ADDR           0x0203FFF0  // above where the loader puts the compressed program
+#define MARK_MAGIC          0x4B4E4C58  // "XLNK"
+
+extern const u8 gShimImage[];
+extern const u8 gShimImageEnd[];
+extern const u32 gColosseumProgram;     // ROM address of Emerald's Colosseum program
+void CpuSet(const void *src, void *dest, u32 control);
+void XdPostLoadArm(void);
+void JumpToProgram(void);
+
+static u32 Hash(const void *src, u32 bytes)
+{
+    const u32 *p = src;
+    u32 h = HASH_BASIS;
+
+    for (bytes /= 4; bytes != 0; bytes--)
+        h = (h ^ *p++) * 0x01000193;
+    return h;
+}
+
+static void PrepareXd(void)
+{
+    u32 i;
+
+    for (i = 0; i < gNumXdPrograms; i++)
+    {
+        const struct XdProgram *p = &gXdPrograms[i];
+        u32 *loader = (u32 *)(EWRAM + p->loaderOffset);
+        u32 *lits = (u32 *)((u8 *)loader + XD_LOADER_LITS);
+
+        // The literals are a quick filter; the hash checks the whole program.
+        if (lits[0] != EWRAM + p->blobEnd || lits[1] != EWRAM + p->blobStart)
+            continue;
+        if (Hash((const void *)EWRAM, p->recvSize) != p->recvHash)
+            continue;
+        loader[XD_LOADER_JUMP / 4] = 0xE59FF008;   // ldr pc, [pc, #8]
+        loader[XD_LOADER_SPARE / 4] = (u32)XdPostLoadArm;
+        ((vu32 *)MARK_ADDR)[0] = MARK_MAGIC;
+        ((vu32 *)MARK_ADDR)[1] = i;
+        ((vu32 *)MARK_ADDR)[2] = ~i;
+        return;
+    }
+}
+
+// Called by Emerald (through _call_via_r0) once a program has been received,
+// in place of its Colosseum check.
+void LinkHook(void)
+{
+    u32 code = GAME_CODE;
+
+    if (code == COLOSSEUM_GAME_CODE)
+    {
+        // What Emerald did here: run its own Colosseum program instead.
+        CpuSet((const void *)gColosseumProgram, (void *)EWRAM, 0x28000 / 2);
+        GAME_CODE = code;
+        return;
+    }
+    if (code == XD_GAME_CODE)
+        PrepareXd();
+}
+
+static void WriteBL(u32 site, u32 target)
+{
+    s32 off = (s32)(target & ~1) - (s32)(site + 4);
+
+    ((vu16 *)site)[0] = 0xF000 | ((off >> 12) & 0x7FF);
+    ((vu16 *)site)[1] = 0xF800 | ((off >> 1) & 0x7FF);
+}
+
+static const u32 sShimCalls[XD_CALL_COUNT] =
+{
+    [XD_CALL_IDENTIFY]   = SHIM_Xd_IdentifyFlash,
+    [XD_CALL_READ]       = SHIM_Xd_ReadFlash,
+    [XD_CALL_VERIFY]     = SHIM_Xd_VerifyFlashSector,
+    [XD_CALL_VERIFY_N]   = SHIM_Xd_VerifyFlashSectorNBytes,
+    [XD_CALL_SAVE_PHASE] = SHIM_Xd_SavePhase,
+};
+
+// Entered (through XdPostLoadArm) from XD's loader, with the program
+// decompressed at 0x02000000 and interrupts off. Never returns.
+void XdPostLoad(void)
+{
+    vu32 *mark = (vu32 *)MARK_ADDR;
+    const struct XdProgram *p = NULL;
+    u32 i;
+
+    if (mark[0] == MARK_MAGIC && mark[1] < gNumXdPrograms && mark[2] == ~mark[1])
+        p = &gXdPrograms[mark[1]];
+    mark[0] = 0;
+
+    if (p != NULL && Hash((const void *)EWRAM, p->decSize) == p->decHash)
+    {
+        const u8 *src = gShimImage;
+        u8 *dst = (u8 *)SHIM___shim_start;
+
+        while (src < gShimImageEnd)
+            *dst++ = *src++;
+        while ((u32)dst < SHIM___shim_bss_end)
+            *dst++ = 0;
+        *(struct XdParams *)SHIM_gXdParams = p->params;
+        for (i = 0; i < p->numSites; i++)
+            WriteBL(p->sites[i].addr, sShimCalls[p->sites[i].call]);
+    }
+    JumpToProgram();
+}
diff --git a/repro_tools/xdlink/linkhook_asm.s b/repro_tools/xdlink/linkhook_asm.s
new file mode 100644
index 0000000..5e1ef8a
--- /dev/null
+++ b/repro_tools/xdlink/linkhook_asm.s
@@ -0,0 +1,45 @@
+@ Small pieces of the link hook that C can't express.
+
+@ linkhook.bin starts with this: what the flasher builder needs to install it.
+    .section .hookhead, "a"
+    .align 2
+    .word   LinkHook                @ Thumb entry (bit 0 set by the linker)
+    .word   0x4B4F4F48              @ "HOOK"
+    .word   __hook_size
+
+    .text
+    .align 2
+
+@ Entered in ARM state from XD's loader (ldr pc, [pc, #8]).
+    .arm
+    .global XdPostLoadArm
+XdPostLoadArm:
+    ldr     r0, =XdPostLoad
+    bx      r0
+
+    .thumb
+    .align 2
+    .global CpuSet
+    .thumb_func
+CpuSet:
+    swi     0x0B
+    bx      lr
+
+@ Starts the decompressed program at 0x02000000 in ARM state, as XD's loader does.
+    .global JumpToProgram
+    .thumb_func
+JumpToProgram:
+    ldr     r0, =0x02000000
+    bx      r0
+
+    .align 2
+    .pool
+
+@ The shim, copied to EWRAM by XdPostLoad.
+    .section .rodata
+    .align 2
+    .global gShimImage, gShimImageEnd
+gShimImage:
+    .incbin "build/shim.bin"
+gShimImageEnd:
+    .align 2
diff --git a/repro_tools/xdlink/make_xd_tables.py b/repro_tools/xdlink/make_xd_tables.py
new file mode 100644
index 0000000..e923351
--- /dev/null
+++ b/repro_tools/xdlink/make_xd_tables.py
@@ -0,0 +1,75 @@
+#!/usr/bin/env python3
+"""Writes xd_tables.c, the list of XD link programs the link hook fixes.
+
+usage: make_xd_tables.py OUTPUT.c PROGRAM.gba [...]
+
+The programs come from patch_colosseum_iso.py extract on an XD disc. Only
+addresses, sizes and hashes go into the output, no bytes of XD's programs.
+"""
+import os
+import sys
+
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+import analyze_xd as A                                   # noqa: E402
+
+COLOSSEUM_PROGRAM = 0x089AA144       # Emerald (BPEE) gMultiBootProgram_PokemonColosseum
+CALLS = [('identify', 'XD_CALL_IDENTIFY'), ('read', 'XD_CALL_READ'), ('verify', 'XD_CALL_VERIFY'),
+         ('verifyN', 'XD_CALL_VERIFY_N'), ('savePhase', 'XD_CALL_SAVE_PHASE')]
+PARAMS = ['identifyFlash', 'readFlash', 'verifyFlashSector', 'verifyFlashSectorNBytes', 'savePhase',
+          'soundVSyncOff', 'soundVSyncOn']
+VARS = ['programFlashByte', 'programFlashSector', 'eraseFlashChip', 'eraseFlashSector', 'waitForFlashWrite',
+        'flashMaxTime', 'flash']
+
+
+def main(argv):
+    if len(argv) < 3:
+        print(__doc__)
+        return 2
+    m = A.Matcher()
+    entries, template = [], None
+    for path in argv[2:]:
+        try:
+            r, prog, img = A.analyze(path, m)
+        except ValueError as e:
+            print('skipped %s: %s' % (os.path.basename(path), e))
+            continue
+        t = A.loader_template(prog, r['loaderOffset'])
+        if template is None:
+            template = t
+        elif t != template:
+            raise SystemExit('error: %s has a different loader' % path)
+        sites = [(s, c) for k, c in CALLS for s in r['sites'][k]]
+        if len(sites) > 8:
+            raise SystemExit('error: too many call sites in %s' % path)
+        entries.append((r, sites))
+        print('%-32s %s, %d sites' % (r['file'], 'trade (writes)' if r['canWrite'] else 'read only', len(sites)))
+    if not entries:
+        raise SystemExit('error: no usable XD program')
+
+    out = ['// Generated by make_xd_tables.py from XD\'s GBA link programs. Do not edit.',
+           '#include "xd_link.h"', '',
+           'const u32 gColosseumProgram = 0x%08X;' % COLOSSEUM_PROGRAM, '',
+           'const struct XdProgram gXdPrograms[] =', '{']
+    for r, sites in entries:
+        out.append('    {   // %s' % r['file'])
+        out.append('        0x%X, 0x%08X, 0x%X, 0x%X, 0x%X, 0x%X, 0x%08X,' % (
+            r['recvSize'], r['recvHash'], r['loaderOffset'], r['blobStart'], r['blobEnd'], r['decSize'], r['decHash']))
+        out.append('        %d,' % len(sites))
+        out.append('        {')
+        for s, c in sites:
+            out.append('            {0x%08X, %s},' % (s, c))
+        out.append('        },')
+        vals = [r['functions'][k] for k in PARAMS] + [r['variables'][k] for k in VARS]
+        out.append('        {')
+        for k, v in zip(PARAMS + VARS, vals):
+            out.append('            0x%08X, // %s' % (v, k))
+        out.append('        },')
+        out.append('    },')
+    out += ['};', '', 'const u32 gNumXdPrograms = %d;' % len(entries), '']
+    open(argv[1], 'w').write('\n'.join(out))
+    print('wrote %s: %d programs' % (argv[1], len(entries)))
+    return 0
+
+
+if __name__ == '__main__':
+    sys.exit(main(sys.argv))
diff --git a/repro_tools/xdlink/rom.ld b/repro_tools/xdlink/rom.ld
new file mode 100644
index 0000000..07cbab4
--- /dev/null
+++ b/repro_tools/xdlink/rom.ld
@@ -0,0 +1,24 @@
+/* The link hook lives in cart ROM, in the unused tail of the area that holds
+   Emerald's Colosseum program. The address is passed with --defsym ROM_ADDR. */
+OUTPUT_ARCH(arm)
+
+SECTIONS
+{
+    .text ROM_ADDR :
+    {
+        __hook_start = .;
+        KEEP(build/linkhook_asm.o(.hookhead));
+        build/linkhook.o(.text);
+        *(.text .text.*);
+        *(.glue_7) *(.glue_7t);
+        *(.rodata .rodata.*);
+        *(.data .data.*);
+        . = ALIGN(4);
+        __hook_end = .;
+    }
+    __hook_size = __hook_end - __hook_start;
+
+    .bss (NOLOAD) : { *(.bss .bss.*) *(COMMON) }
+
+    /DISCARD/ : { *(.comment) *(.ARM.attributes) *(.note*) }
+}
diff --git a/repro_tools/xdlink/shim.ld b/repro_tools/xdlink/shim.ld
new file mode 100644
index 0000000..0b227ac
--- /dev/null
+++ b/repro_tools/xdlink/shim.ld
@@ -0,0 +1,31 @@
+/* The XD shim runs from the top of EWRAM, above everything XD's programs use
+   (image, .bss and the save blocks they allocate after it; analyze_xd.py
+   checks this for each program). linkhook.c copies it there. The last 128
+   bytes stay free for the hook's marker. */
+OUTPUT_ARCH(arm)
+
+SECTIONS
+{
+    .text 0x0203E800 :
+    {
+        __shim_start = .;
+        *(.text .text.*);
+        *(.glue_7) *(.glue_7t);
+        *(.rodata .rodata.*);
+        *(.data .data.*);
+        . = ALIGN(4);
+        __shim_image_end = .;
+    }
+
+    .bss (NOLOAD) :
+    {
+        __shim_bss_start = .;
+        *(.bss .bss.*);
+        *(COMMON);
+        . = ALIGN(4);
+        __shim_bss_end = .;
+    }
+
+    /DISCARD/ : { *(.comment) *(.ARM.attributes) *(.note*) }
+}
+ASSERT(__shim_bss_end <= 0x0203FF80, "the shim is too large for the top of EWRAM")
diff --git a/repro_tools/xdlink/xd_link.h b/repro_tools/xdlink/xd_link.h
new file mode 100644
index 0000000..9ad1cb2
--- /dev/null
+++ b/repro_tools/xdlink/xd_link.h
@@ -0,0 +1,41 @@
+#ifndef GUARD_XD_LINK_H
+#define GUARD_XD_LINK_H
+
+#include "repro_types.h"
+#include "xd_params.h"
+
+#define XD_MAX_SITES 8
+
+// The IWRAM loader at the end of each XD link program (identical in all of
+// them): it moves the compressed program to the top of EWRAM, decompresses it
+// to 0x02000000 and jumps there.
+#define XD_LOADER_SIZE  0x1C4
+#define XD_LOADER_JUMP  0x1AC   // "bx r5", the jump to 0x02000000
+#define XD_LOADER_SPARE 0x1BC   // never reached; holds the new jump target
+#define XD_LOADER_LITS  0x1B4   // blob end, blob start
+
+struct XdSite
+{
+    u32 addr;   // a BL instruction in the decompressed program
+    u32 call;   // XD_CALL_*
+};
+
+// One XD link program, as sent by the GameCube and after decompression.
+struct XdProgram
+{
+    u32 recvSize;       // bytes hashed of the program as received
+    u32 recvHash;
+    u32 loaderOffset;
+    u32 blobStart;      // compressed program, offsets in the received image
+    u32 blobEnd;
+    u32 decSize;        // bytes hashed after decompression
+    u32 decHash;
+    u32 numSites;
+    struct XdSite sites[XD_MAX_SITES];
+    struct XdParams params;
+};
+
+extern const struct XdProgram gXdPrograms[];
+extern const u32 gNumXdPrograms;
+
+#endif // GUARD_XD_LINK_H
diff --git a/repro_tools/xdlink/xd_params.h b/repro_tools/xdlink/xd_params.h
new file mode 100644
index 0000000..49239b3
--- /dev/null
+++ b/repro_tools/xdlink/xd_params.h
@@ -0,0 +1,42 @@
+#ifndef GUARD_XD_PARAMS_H
+#define GUARD_XD_PARAMS_H
+
+#include "repro_types.h"
+
+// Addresses inside one of Pokemon XD's GBA link programs (after it has
+// decompressed itself), found by analyze_xd.py. The link hook copies the
+// matching set into the shim before the program starts.
+struct XdParams
+{
+    // XD's own functions, Thumb (bit 0 set)
+    u32 identifyFlash;
+    u32 readFlash;
+    u32 verifyFlashSector;
+    u32 verifyFlashSectorNBytes;
+    u32 savePhase;              // 0 when the program never writes the save
+    u32 soundVSyncOff;          // m4aSoundVSyncOff
+    u32 soundVSyncOn;           // m4aSoundVSyncOn
+    // XD's flash library variables
+    u32 programFlashByte;
+    u32 programFlashSector;
+    u32 eraseFlashChip;
+    u32 eraseFlashSector;
+    u32 waitForFlashWrite;
+    u32 flashMaxTime;
+    u32 flash;
+};
+
+// Which shim entry a redirected call goes to.
+enum
+{
+    XD_CALL_IDENTIFY,
+    XD_CALL_READ,
+    XD_CALL_VERIFY,
+    XD_CALL_VERIFY_N,
+    XD_CALL_SAVE_PHASE,
+    XD_CALL_COUNT
+};
+
+extern struct XdParams gXdParams;
+
+#endif // GUARD_XD_PARAMS_H
diff --git a/repro_tools/xdlink/xd_shim.c b/repro_tools/xdlink/xd_shim.c
new file mode 100644
index 0000000..dbca550
--- /dev/null
+++ b/repro_tools/xdlink/xd_shim.c
@@ -0,0 +1,65 @@
+// Batteryless save fix for Pokemon XD's GBA link programs.
+//
+// XD sends its own GBA program, and Emerald runs it as sent. That program
+// looks for a flash save chip, which batteryless repro carts don't have. The
+// cart's link hook (linkhook.c) copies this code into free EWRAM and
+// redirects the program's calls to IdentifyFlash, ReadFlash,
+// VerifyFlashSector(NBytes) and its save step here. The save is then read
+// from and written to the cart's ROM flash by the same backend as the
+// Colosseum repro build (payload/src/repro), which is linked in unchanged.
+
+#include "repro_types.h"
+#include "gba/flash_internal.h"
+#include "repro_flash.h"
+#include "xd_params.h"
+
+struct XdParams gXdParams;
+
+u16 Xd_IdentifyFlash(void)
+{
+    // A save image inside cart ROM means a batteryless repro cart.
+    if (ReproFlash_Detect())
+        return 0;
+    return ((u16 (*)(void))gXdParams.identifyFlash)();
+}
+
+void Xd_ReadFlash(u16 sectorNum, u32 offset, void *dest, u32 size)
+{
+    if (gReproActive)
+    {
+        ReproFlash_Read(sectorNum, offset, dest, size);
+        return;
+    }
+    ((void (*)(u16, u32, void *, u32))gXdParams.readFlash)(sectorNum, offset, dest, size);
+}
+
+u32 Xd_VerifyFlashSector(u16 sectorNum, u8 *src)
+{
+    if (gReproActive)
+        return ReproFlash_Verify(sectorNum, src, REPRO_SECTOR_SIZE);
+    return ((u32 (*)(u16, u8 *))gXdParams.verifyFlashSector)(sectorNum, src);
+}
+
+u32 Xd_VerifyFlashSectorNBytes(u16 sectorNum, u8 *src, u32 n)
+{
+    if (gReproActive)
+        return ReproFlash_Verify(sectorNum, src, n);
+    return ((u32 (*)(u16, u8 *, u32))gXdParams.verifyFlashSectorNBytes)(sectorNum, src, n);
+}
+
+// The link code's save step: SavePhase(0) writes the save except one byte,
+// SavePhase(1) writes that byte. As in the Colosseum repro build, each phase
+// is written to cart ROM before its result goes back to the GameCube.
+bool32 Xd_SavePhase(s32 phase)
+{
+    bool32 failed = ((bool32 (*)(s32))gXdParams.savePhase)(phase);
+
+    if (!failed && gReproActive)
+    {
+        ((void (*)(void))gXdParams.soundVSyncOff)();
+        if (ReproFlash_Commit() != 0)
+            failed = TRUE;
+        ((void (*)(void))gXdParams.soundVSyncOn)();
+    }
+    return failed;
+}
