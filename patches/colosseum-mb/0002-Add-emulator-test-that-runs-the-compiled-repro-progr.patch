+#!/usr/bin/env python3
+"""Runs the compiled repro link program (payload-repro) in an ARM emulator
+against the simulated carts in sim_cart.c, through the real save code:
+detect -> load save -> link save (both phases, with the GameCube handshake
+emulated) -> read the save back after a "power cycle".
+
+usage: emu_test.py [path/to/payload-repro.elf]
+"""
+import ctypes
+import os
+import struct
+import subprocess
+import sys
+
+from unicorn import Uc, UC_ARCH_ARM, UC_MODE_ARM, UC_HOOK_INTR, UC_HOOK_MEM_WRITE, UcError
+from unicorn.arm_const import (UC_ARM_REG_R0, UC_ARM_REG_R1, UC_ARM_REG_R2, UC_ARM_REG_R3,
+                               UC_ARM_REG_SP, UC_ARM_REG_LR, UC_ARM_REG_PC, UC_ARM_REG_CPSR)
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+ROOT = os.path.normpath(os.path.join(HERE, '..', '..'))
+ELF = sys.argv[1] if len(sys.argv) > 1 else os.path.join(ROOT, 'payload', 'payload-repro.elf')
+BIN = os.path.splitext(ELF)[0] + '.gba'
+
+SAVE_OFFSET = 0xFC0000
+SECTOR = 0x1000
+SIG = 0x08012025
+
+# Emerald sizes as reported by its GF ROM header
+SB2_SIZE = 0xF2C
+SB1_SIZE = 0x3D88
+STORAGE_SIZE = 0x83D0
+CHUNK_SIZES = [SB2_SIZE, 0xF80, 0xF80, 0xF80, SB1_SIZE % 0xF80] + [0xF80] * 8 + [STORAGE_SIZE % 0xF80]
+
+lib = ctypes.CDLL(os.path.join(HERE, 'libsimcart.so'))
+lib.HostRomRead16.restype = ctypes.c_uint16
+lib.HostRomRead16.argtypes = [ctypes.c_uint32]
+lib.HostRomWrite16.argtypes = [ctypes.c_uint32, ctypes.c_uint16]
+lib.HostSramRead8.restype = ctypes.c_uint8
+lib.HostSramRead8.argtypes = [ctypes.c_uint32]
+lib.HostSramWrite8.argtypes = [ctypes.c_uint32, ctypes.c_uint8]
+lib.HostBankWrite8.argtypes = [ctypes.c_uint8]
+lib.SimInit.argtypes = [ctypes.c_int, ctypes.c_uint32]
+lib.SimRom.restype = ctypes.POINTER(ctypes.c_uint8)
+
+
+class SimStats(ctypes.Structure):
+    _fields_ = [('erases', ctypes.c_uint), ('programs', ctypes.c_uint), ('violations', ctypes.c_uint),
+                ('strayWrites', ctypes.c_uint), ('badBankWrites', ctypes.c_uint)]
+
+
+lib.SimStats.restype = ctypes.POINTER(SimStats)
+lib.SimLastViolation.restype = ctypes.c_char_p
+
+BOARDS = {'plain': 0, 'intel_buffered': 1, 'intel_word': 2, 'amd_swapped': 3, 'amd_dual': 4, 'amd_x16': 5}
+
+failures = 0
+
+
+def check(cond, msg):
+    global failures
+    if not cond:
+        failures += 1
+        print('    FAIL:', msg)
+
+
+def symbols():
+    out = subprocess.run(['arm-none-eabi-nm', ELF], capture_output=True, text=True, check=True).stdout
+    syms = {}
+    for line in out.splitlines():
+        parts = line.split()
+        if len(parts) == 3:
+            syms[parts[2]] = int(parts[0], 16)
+    return syms
+
+
+SYMS = symbols()
+PAYLOAD = open(BIN, 'rb').read()
+
+
+def rom_view():
+    return ctypes.cast(lib.SimRom(), ctypes.POINTER(ctypes.c_uint8 * (32 * 1024 * 1024))).contents
+
+
+def checksum(data, size):
+    s = sum(struct.unpack_from('<%dI' % (size // 4), data)) & 0xFFFFFFFF
+    return ((s >> 16) + s) & 0xFFFF
+
+
+def make_sector(chunk_id, counter, seed):
+    size = CHUNK_SIZES[chunk_id]
+    body = bytearray((i * 7 + chunk_id * 13 + seed * 31) & 0xFF for i in range(size))
+    sector = bytearray(SECTOR)
+    sector[:size] = body
+    struct.pack_into('<HHII', sector, 0xFF4, chunk_id, checksum(sector, size), SIG, counter)
+    return sector
+
+
+def write_slot(rom, slot, counter, rotation, seed):
+    for cid in range(14):
+        phys = slot * 14 + (cid + rotation) % 14
+        off = SAVE_OFFSET + phys * SECTOR
+        rom[off:off + SECTOR] = make_sector(cid, counter, seed)
+
+
+def build_rom(board):
+    lib.SimInit(BOARDS[board], 99)
+    rom = rom_view()
+    ctypes.memset(ctypes.addressof(rom) + SAVE_OFFSET, 0xFF, 0x20000)
+    write_slot(rom, 0, 20, 5, seed=1)   # newest: counter 20 in slot A (20 % 2 == 0)
+    write_slot(rom, 1, 19, 4, seed=2)
+    # GF ROM header at 0x100 with the fields the save code uses
+    hdr = bytearray(0x100)
+    struct.pack_into('<II', hdr, 0, 5, 2)          # version Emerald, language English
+    # field offsets inside struct GFRomHeader
+    struct.pack_into('<I', hdr, 0x50, 0x1270)       # flagsOffset
+    struct.pack_into('<I', hdr, 0x54, 0x139C)       # varsOffset
+    struct.pack_into('<I', hdr, 0x58, 0x18)         # pokedexOffset
+    struct.pack_into('<I', hdr, 0x5C, 0x988)        # seen1Offset
+    struct.pack_into('<I', hdr, 0x60, 0x3B24)       # seen2Offset
+    struct.pack_into('<III', hdr, 0x88, SB2_SIZE, SB1_SIZE, 0x234)  # sizes, partyCountOffset
+    struct.pack_into('<I', hdr, 0x94, 0x238)        # partyOffset
+    rom[0x100:0x200] = hdr
+    return rom
+
+
+class Gba:
+    STOP = 0x03007F00
+
+    def __init__(self):
+        uc = Uc(UC_ARCH_ARM, UC_MODE_ARM)
+        uc.mem_map(0x00000000, 0x4000)           # BIOS (unused, SWIs are hooked)
+        uc.mem_map(0x02000000, 0x40000)          # EWRAM
+        uc.mem_map(0x03000000, 0x8000)           # IWRAM
+        uc.mem_map(0x04000000, 0x1000)           # I/O
+        uc.mem_map(0x05000000, 0x400)
+        uc.mem_map(0x06000000, 0x18000)
+        uc.mem_map(0x07000000, 0x400)
+        uc.mmio_map(0x08000000, 0x02000000, self.rom_read, None, self.rom_write, None)
+        uc.mmio_map(0x0E000000, 0x10000, self.sram_read, None, self.sram_write, None)
+        uc.mem_write(0x02000000, PAYLOAD)
+        uc.mem_write(0x04000130, struct.pack('<H', 0x3FF))   # no keys held
+        uc.mem_write(self.STOP, struct.pack('<H', 0xE7FE))   # thumb: b .
+        # The sprite system is never initialised here; DelayFrames would walk
+        # an empty sprite list forever. Make UpdateSprites return at once.
+        uc.mem_write(SYMS['UpdateSprites'] & ~1, struct.pack('<H', 0x4770))  # thumb: bx lr
+        uc.hook_add(UC_HOOK_INTR, self.swi)
+        uc.hook_add(UC_HOOK_MEM_WRITE, self.joy_write, begin=0x04000154, end=0x04000157)
+        self.uc = uc
+        self.gc_acks = 0
+        self.swis = {}
+
+    # cart bus
+    def rom_read(self, uc, offset, size, data):
+        if size == 1:
+            return (lib.HostRomRead16(offset & ~1) >> ((offset & 1) * 8)) & 0xFF
+        if size == 2:
+            return lib.HostRomRead16(offset)
+        return lib.HostRomRead16(offset) | (lib.HostRomRead16(offset + 2) << 16)
+
+    def rom_write(self, uc, offset, size, value, data):
+        if offset == 0x01000000 and size == 1:
+            lib.HostBankWrite8(value)
+        elif size == 2:
+            lib.HostRomWrite16(offset, value)
+        else:
+            raise RuntimeError('unexpected %d-byte cart write at 0x%X' % (size, offset))
+
+    def sram_read(self, uc, offset, size, data):
+        if size != 1:
+            raise RuntimeError('SRAM is 8-bit only (read size %d at 0x%X)' % (size, offset))
+        return lib.HostSramRead8(offset)
+
+    def sram_write(self, uc, offset, size, value, data):
+        if size != 1:
+            raise RuntimeError('SRAM is 8-bit only (write size %d at 0x%X)' % (size, offset))
+        lib.HostSramWrite8(offset, value)
+
+    # GameCube side of the save handshake: when the GBA reports phase 1 done
+    # (JOY_TRANS = 0), send command 0x44, which sets unk84C_02 and unk84C_03;
+    # the GameCube then reads the echo, which clears unk84C_03.
+    def joy_write(self, uc, access, address, size, value, data):
+        flags = SYMS['gMonLinkData'] + 0x84C
+        b = uc.mem_read(flags, 1)[0]
+        if value == 0 and not (b & 4) and self.gc_acks == 0:
+            self.gc_acks += 1
+            uc.mem_write(flags, bytes([(b | 4) & ~8]))
+
+    def swi(self, uc, intno, data):
+        pc = uc.reg_read(UC_ARM_REG_PC)
+        cpsr = uc.reg_read(UC_ARM_REG_CPSR)
+        thumb = cpsr & 0x20
+        insn_addr = pc - (2 if thumb else 4)
+        num = uc.mem_read(insn_addr, 1)[0] if thumb else uc.mem_read(insn_addr + 2, 1)[0]
+        self.swis[num] = self.swis.get(num, 0) + 1
+        r0, r1, r2 = (uc.reg_read(r) for r in (UC_ARM_REG_R0, UC_ARM_REG_R1, UC_ARM_REG_R2))
+        if num in (0x04, 0x05, 0x01, 0x02):   # IntrWait, VBlankIntrWait, RegisterRamReset, Halt
+            return
+        if num == 0x06:                        # Div
+            q = int(r0 if r0 < 0x80000000 else r0 - (1 << 32)) // int(r1 if r1 < 0x80000000 else r1 - (1 << 32))
+            uc.reg_write(UC_ARM_REG_R0, q & 0xFFFFFFFF)
+            return
+        if num in (0x0B, 0x0C):                # CpuSet, CpuFastSet
+            count = r2 & 0x1FFFFF
+            word = 4 if (num == 0x0C or r2 & (1 << 26)) else 2
+            fill = r2 & (1 << 24)
+            if fill:
+                v = uc.mem_read(r0, word)
+                uc.mem_write(r1, bytes(v) * count)
+            else:
+                uc.mem_write(r1, bytes(uc.mem_read(r0, count * word)))
+            return
+        raise RuntimeError('unhandled SWI 0x%X at 0x%X' % (num, insn_addr))
+
+    def call(self, name, *args):
+        uc = self.uc
+        for reg, val in zip((UC_ARM_REG_R0, UC_ARM_REG_R1, UC_ARM_REG_R2, UC_ARM_REG_R3), args):
+            uc.reg_write(reg, val)
+        uc.reg_write(UC_ARM_REG_SP, 0x03007E00)
+        uc.reg_write(UC_ARM_REG_LR, self.STOP | 1)
+        uc.emu_start(SYMS[name] | 1, self.STOP, count=200_000_000)
+        return uc.reg_read(UC_ARM_REG_R0)
+
+    def u8(self, name, off=0):
+        return self.uc.mem_read(SYMS[name] + off, 1)[0]
+
+    def u32(self, addr):
+        return struct.unpack('<I', self.uc.mem_read(addr, 4))[0]
+
+
+def scan_rom(rom):
+    """Newest complete slot counter and both slots' status, from ROM."""
+    out = []
+    for slot in range(2):
+        ids, counters = set(), set()
+        for i in range(14):
+            off = SAVE_OFFSET + (slot * 14 + i) * SECTOR
+            cid, _, sig, counter = struct.unpack_from('<HHII', bytes(rom[off + 0xFF4:off + 0x1000]))
+            if sig == SIG:
+                ids.add(cid)
+                counters.add(counter)
+        out.append(counters.pop() if ids == set(range(14)) and len(counters) == 1 else None)
+    return out
+
+
+def boot_and_read(expect_marker=None):
+    gba = Gba()
+    gba.call('DetectROM')
+    scratch = 0x03007000
+    rc = gba.call('InitFlash', 2, scratch)
+    gba.call('SaveBlocksInit')
+    gba.call('SetSaveSectorPtrs')
+    status = gba.call('ReadSaveBlockChunks')
+    return gba, rc, status
+
+
+def run(board, expect_type, writable):
+    print('  board:', board)
+    rom = build_rom(board)
+    before = bytes(rom)
+
+    gba, rc, status = boot_and_read()
+    check(rc == 0, 'InitFlash returned %d' % rc)
+    check(gba.u8('gReproActive') == 1, 'repro mode not active')
+    check(gba.u32(SYMS['gReproSaveOffset']) == SAVE_OFFSET, 'save offset 0x%X' % gba.u32(SYMS['gReproSaveOffset']))
+    check(status == 1, 'ReadSaveBlockChunks status %d' % status)
+    check(gba.u32(SYMS['gSaveCounter']) == 20, 'save counter %d' % gba.u32(SYMS['gSaveCounter']))
+    sb2 = gba.u32(SYMS['gSaveBlock2Ptr'])
+    expected_sb2 = make_sector(0, 20, 1)[:SB2_SIZE]
+    check(bytes(gba.uc.mem_read(sb2, SB2_SIZE)) == bytes(expected_sb2), 'SaveBlock2 does not match the newest slot')
+    check(bytes(rom) == before, 'reading the save changed the cart ROM')
+    check(gba.u8('gReproSession') == 0, 'reading opened a write session')
+
+    # Change the trainer data and run the real link save handshake.
+    marker = b'REPRO-TEST'
+    gba.uc.mem_write(sb2, marker)
+    failed = gba.call('sub_02005FCC')
+    stats = lib.SimStats().contents
+    print('    sub_02005FCC -> %d, cart type %d, last error 0x%X, erases %d, program ops %d, SWIs %s' % (
+        failed, gba.u8('gReproCartType'), struct.unpack('<H', gba.uc.mem_read(SYMS['gReproLastError'], 2))[0],
+        stats.erases, stats.programs, gba.swis))
+    check(gba.u8('gReproCartType') == expect_type, 'cart type %d, expected %d' % (gba.u8('gReproCartType'), expect_type))
+    check(stats.violations == 0, 'chip violations: %d (%s)' % (stats.violations, lib.SimLastViolation()))
+    check(stats.badBankWrites == 0, 'bad bank register writes: %d' % stats.badBankWrites)
+
+    rom_now = bytes(rom)
+    check(rom_now[:SAVE_OFFSET] == before[:SAVE_OFFSET] and rom_now[SAVE_OFFSET + 0x20000:] == before[SAVE_OFFSET + 0x20000:],
+          'ROM changed outside the save area')
+
+    if not writable:
+        check(failed == 1, 'save should be refused on this board')
+        check(rom_now == before, 'refused save still changed the cart ROM')
+        return
+
+    check(failed == 0, 'link save failed')
+    check(gba.gc_acks == 1, 'GameCube handshake did not happen')
+    check(scan_rom(rom) == [20, 21], 'slots after save: %s' % scan_rom(rom))
+
+    # Power cycle: a fresh boot must read the new save.
+    gba2, rc2, status2 = boot_and_read()
+    check(status2 == 1 and gba2.u32(SYMS['gSaveCounter']) == 21, 'after reboot: status %d counter %d' % (
+        status2, gba2.u32(SYMS['gSaveCounter'])))
+    sb2b = gba2.u32(SYMS['gSaveBlock2Ptr'])
+    check(bytes(gba2.uc.mem_read(sb2b, len(marker))) == marker, 'changed trainer data not read back after reboot')
+
+    # Second save in the same session goes to the other slot.
+    gba.uc.mem_write(sb2, b'SECOND-SAV')
+    gba.gc_acks = 0
+    failed = gba.call('sub_02005FCC')
+    check(failed == 0, 'second link save failed')
+    check(scan_rom(rom) == [22, 21], 'slots after second save: %s' % scan_rom(rom))
+    check(lib.SimStats().contents.violations == 0, 'chip violations after second save (%s)' % lib.SimLastViolation())
+
+
+def main():
+    print('emulating', os.path.relpath(ELF, ROOT))
+    run('amd_swapped', 3, True)
+    run('amd_dual', 4, True)
+    run('intel_buffered', 1, True)
+    run('intel_word', 2, True)
+    run('amd_x16', 5, False)
+    run('plain', 0, False)
+    print('%d FAILURES' % failures if failures else 'all emulator tests passed')
+    return 1 if failures else 0
+
+
+if __name__ == '__main__':
+    sys.exit(main())
