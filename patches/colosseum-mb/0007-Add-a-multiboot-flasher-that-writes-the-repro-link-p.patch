+#ifndef GUARD_CONSOLE_H
+#define GUARD_CONSOLE_H
+
+// 30x20 text console on BG0.
+
+enum
+{
+    COLOR_WHITE,
+    COLOR_GREEN,
+    COLOR_RED,
+    COLOR_YELLOW,
+    COLOR_GRAY,
+};
+
+#define CON_COLS 30
+#define CON_ROWS 20
+
+void Con_Init(void);
+void Con_SetColor(u32 color);
+void Con_Putc(u32 c);
+void Con_Print(const char *s);
+void Con_Hex(u32 value, u32 digits);
+void Con_Dec(u32 value);
+void Con_ClearLine(void);   // blank the cursor's row and return to its start
+void Con_Bar(u32 done, u32 total); // progress bar on the cursor's row, from the cursor
+
+#endif // GUARD_CONSOLE_H
diff --git a/repro_tools/flasher/crt0.s b/repro_tools/flasher/crt0.s
new file mode 100644
index 0000000..d206b94
--- /dev/null
+++ b/repro_tools/flasher/crt0.s
@@ -0,0 +1,59 @@
+@ Multiboot start-up for the flasher. The header fields left empty here
+@ (Nintendo logo, complement check) are filled in by make_flasher.py from
+@ the user's own ROM dump.
+
+    .section .crt0, "ax", %progbits
+    .arm
+    .global _start
+_start:
+    b       start_vector            @ 0x00 cartridge entry (unused)
+    .fill   156, 1, 0               @ 0x04 Nintendo logo
+    .ascii  "EMERALDFLASH"          @ 0xA0 title
+    .ascii  "FLSH"                  @ 0xAC game code
+    .ascii  "01"                    @ 0xB0 maker code
+    .byte   0x96                    @ 0xB2 fixed value
+    .byte   0x00                    @ 0xB3 main unit
+    .byte   0x00                    @ 0xB4 device type
+    .fill   7, 1, 0                 @ 0xB5 reserved
+    .byte   0x00                    @ 0xBC version
+    .byte   0x00                    @ 0xBD complement check
+    .fill   2, 1, 0                 @ 0xBE reserved
+
+    b       start_vector            @ 0xC0 multiboot entry (normal/multiplay)
+    .byte   0                       @ 0xC4 boot mode, written by the BIOS
+    .byte   0                       @ 0xC5 slave number, written by the BIOS
+    .fill   26, 1, 0                @ 0xC6 unused
+    b       start_vector            @ 0xE0 multiboot entry (JOY bus)
+
+start_vector:
+    mov     r0, #0x04000000
+    str     r0, [r0, #0x208]        @ IME = 0: the flasher runs without interrupts
+
+    mov     r0, #0xD2               @ IRQ mode, interrupts masked
+    msr     cpsr_c, r0
+    ldr     sp, =0x03007FA0
+    mov     r0, #0xDF               @ system mode, interrupts masked
+    msr     cpsr_c, r0
+    ldr     sp, =0x03007F00
+
+    ldr     r0, =__iwram_lma        @ ARM code that runs from IWRAM
+    ldr     r1, =__iwram_start
+    ldr     r2, =__iwram_end
+1:  cmp     r1, r2
+    ldrlo   r3, [r0], #4
+    strlo   r3, [r1], #4
+    blo     1b
+
+    ldr     r1, =__bss_start
+    ldr     r2, =__bss_end
+    mov     r3, #0
+2:  cmp     r1, r2
+    strlo   r3, [r1], #4
+    blo     2b
+
+    ldr     r0, =AgbMain
+    mov     lr, pc
+    bx      r0
+3:  b       3b
+
+    .pool
diff --git a/repro_tools/flasher/flasher.ld b/repro_tools/flasher/flasher.ld
new file mode 100644
index 0000000..51a0743
--- /dev/null
+++ b/repro_tools/flasher/flasher.ld
@@ -0,0 +1,46 @@
+/* Multiboot image: everything loads at 0x02000000 (EWRAM). ARM code in
+   .iwram is copied to IWRAM by crt0; .bss lives in IWRAM. make_flasher.py
+   appends the per-dump data at the first 32-byte boundary after
+   __image_end. */
+OUTPUT_ARCH(arm)
+ENTRY(_start)
+
+MEMORY
+{
+    ewram (rwx) : ORIGIN = 0x02000000, LENGTH = 0x40000
+    iwram (rwx) : ORIGIN = 0x03000000, LENGTH = 0x7C00
+}
+
+SECTIONS
+{
+    .text :
+    {
+        build/crt0.o(.crt0);
+        *(.text .text.*);
+        *(.glue_7) *(.glue_7t);
+        *(.rodata .rodata.*);
+        *(.data .data.*);
+        . = ALIGN(4);
+    } > ewram
+
+    .iwram :
+    {
+        __iwram_start = .;
+        *(.iwram .iwram.*);
+        . = ALIGN(4);
+        __iwram_end = .;
+    } > iwram AT > ewram
+    __iwram_lma = LOADADDR(.iwram);
+    __image_end = LOADADDR(.iwram) + SIZEOF(.iwram);
+
+    .bss (NOLOAD) :
+    {
+        __bss_start = .;
+        *(.bss .bss.*);
+        *(COMMON);
+        . = ALIGN(4);
+        __bss_end = .;
+    } > iwram
+
+    /DISCARD/ : { *(.comment) *(.ARM.attributes) *(.note*) }
+}
