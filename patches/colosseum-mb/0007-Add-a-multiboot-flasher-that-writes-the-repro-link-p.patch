index 0000000..26db879
--- /dev/null
+++ b/repro_tools/flasher/Makefile
@@ -0,0 +1,50 @@
+# Builds flasher_code.bin, the code part of the multiboot flasher.
+# make_flasher.py adds the data from the user's dump to make the .gba.
+# Needs agbcc in ../../tools/agbcc (see the colosseum-mb INSTALL.md) and
+# binutils for arm-none-eabi.
+
+AGBCC   := ../../tools/agbcc
+CC1     := $(AGBCC)/bin/agbcc
+CC1_OLD := $(AGBCC)/bin/old_agbcc
+PREFIX  := arm-none-eabi-
+CPP     := $(PREFIX)cpp
+AS      := $(PREFIX)as
+LD      := $(PREFIX)ld
+OBJCOPY := $(PREFIX)objcopy
+
+CPPFLAGS := -I $(AGBCC)/include -iquote . -iquote ../../payload/include -nostdinc -undef
+CFLAGS   := -O2 -mthumb-interwork -fhex-asm -Wimplicit -Werror
+ASFLAGS  := -mcpu=arm7tdmi
+
+BUILD := build
+OBJS  := $(BUILD)/crt0.o $(BUILD)/hash.o $(BUILD)/main.o $(BUILD)/console.o $(BUILD)/cfi.o $(BUILD)/repro_cart.o
+
+# A copy goes next to make_flasher.py, which is where it looks for it.
+flasher_code.bin: $(BUILD)/flasher.elf
+	$(OBJCOPY) -O binary $< $@
+	cp $@ ../flasher_code.bin
+
+$(BUILD)/flasher.elf: $(OBJS) flasher.ld
+	$(LD) -T flasher.ld -Map $(BUILD)/flasher.map -o $@ $(OBJS) -L $(AGBCC)/lib -lgcc -lc
+
+$(BUILD)/%.o: %.s | $(BUILD)
+	$(AS) $(ASFLAGS) -o $@ $<
+
+$(BUILD)/%.o: %.c *.h | $(BUILD)
+	$(CPP) $(CPPFLAGS) $< -o $(BUILD)/$*.i
+	$(CC1) $(CFLAGS) -o $(BUILD)/$*.s < $(BUILD)/$*.i
+	$(AS) $(ASFLAGS) -o $@ $(BUILD)/$*.s
+
+# The chip code is the save backend's, built the same way as in the payload.
+$(BUILD)/repro_cart.o: ../../payload/src/repro/repro_cart.c ../../payload/include/repro_*.h | $(BUILD)
+	$(CPP) $(CPPFLAGS) $< -o $(BUILD)/repro_cart.i
+	$(CC1_OLD) $(CFLAGS) -o $(BUILD)/repro_cart.s < $(BUILD)/repro_cart.i
+	$(AS) $(ASFLAGS) -o $@ $(BUILD)/repro_cart.s
+
+$(BUILD):
+	mkdir -p $@
+
+clean:
+	rm -rf $(BUILD) flasher_code.bin
+
+.PHONY: clean
diff --git a/repro_tools/flasher/cfi.c b/repro_tools/flasher/cfi.c
new file mode 100644
index 0000000..f38fd4f
--- /dev/null
+++ b/repro_tools/flasher/cfi.c
@@ -0,0 +1,162 @@
+// CFI (Common Flash Interface) query of the cart's flash chip(s), used to
+// learn the erase block size before anything is erased.
+#include "repro_types.h"
+#include "repro_hw.h"
+#include "repro_cart.h"
+#include "cfi.h"
+
+static u8 Unswap(u8 v)
+{
+    return (v & 0xFC) | ((v & 1) << 1) | ((v >> 1) & 1);
+}
+
+// Sends the CFI query for this board. Returns the distance in bytes between
+// consecutive CFI items, or 0 for boards without a known query.
+static u32 EnterCfi(const struct ReproCart *cart, u32 *lanes)
+{
+    switch (cart->type)
+    {
+    case REPRO_CART_INTEL_BUFFERED:
+    case REPRO_CART_INTEL_WORD:
+        // x16 Intel: 0x98 at any address; 0x98 is the same with D0/D1 swapped.
+        ROM_WRITE16(0, 0xFF);
+        ROM_WRITE16(0, 0x98);
+        *lanes = 1;
+        return 2;
+    case REPRO_CART_AMD_SWAPPED:
+        // x16 AMD: 0x98 at word address 0x55.
+        ROM_WRITE16(0, 0xF0);
+        ROM_WRITE16(0xAA, 0x98);
+        *lanes = 1;
+        return 2;
+    case REPRO_CART_AMD_DUAL:
+        // Two x8 chips: 0x98 at byte address 0xAA of each chip, which the
+        // board maps to halfword 0xAA of the bus. Items sit at chip byte
+        // addresses 2n, so bus byte offsets 4n.
+        ROM_WRITE16(0, 0xF0F0);
+        ROM_WRITE16(0x154, 0x9898);
+        *lanes = 2;
+        return 4;
+    }
+    return 0;
+}
+
+static u8 RawItem(u32 n, u32 stride, u32 lane)
+{
+    return ROM_READ16(n * stride) >> (lane * 8);
+}
+
+static u8 Item(u32 n, u32 stride, u32 lane, bool32 swapped)
+{
+    u8 v = RawItem(n, stride, lane);
+    return swapped ? Unswap(v) : v;
+}
+
+// Decodes one lane. Returns FALSE if the answer is not a consistent CFI table.
+static bool32 ReadLane(u32 stride, u32 lane, struct CfiInfo *info, bool32 *swapped)
+{
+    u8 q = RawItem(0x10, stride, lane);
+    u8 r = RawItem(0x11, stride, lane);
+    u8 y = RawItem(0x12, stride, lane);
+    u32 i, total, sizeLog2, count, size, field;
+
+    if (lane == 0)
+    {
+        info->raw[0] = q;
+        info->raw[1] = r;
+        info->raw[2] = y;
+    }
+
+    if (q == 'Q' && r == 'R' && y == 'Y')
+        *swapped = FALSE;
+    else if (q == Unswap('Q') && r == Unswap('R') && y == Unswap('Y'))
+        *swapped = TRUE;
+    else
+        return FALSE;
+
+    sizeLog2 = Item(0x27, stride, lane, *swapped);
+    info->numRegions = Item(0x2C, stride, lane, *swapped);
+    if (sizeLog2 < 16 || sizeLog2 > 26 || info->numRegions == 0 || info->numRegions > CFI_MAX_REGIONS)
+        return FALSE;
+    info->sizeLog2 = sizeLog2;
+
+    total = 0;
+    for (i = 0; i < info->numRegions; i++)
+    {
+        count = Item(0x2D + i * 4, stride, lane, *swapped) | (Item(0x2E + i * 4, stride, lane, *swapped) << 8);
+        field = Item(0x2F + i * 4, stride, lane, *swapped) | (Item(0x30 + i * 4, stride, lane, *swapped) << 8);
+        count += 1;
+        size = field ? field * 256 : 128;
+        if (size & (size - 1))
+            return FALSE;
+        info->regionBlocks[i] = count;
+        info->regionSize[i] = size;
+        total += count * size;
+    }
+
+    return total == (1u << sizeLog2);
+}
+
+bool32 Cfi_Read(const struct ReproCart *cart, struct CfiInfo *info)
+{
+    u16 ime;
+    u16 header0 = ROM_READ16(0);
+    u16 header1 = ROM_READ16(2);
+    u32 lanes = 0;
+    u32 stride;
+    u32 i, largest;
+    bool32 ok = FALSE;
+    bool32 swapped;
+    struct CfiInfo other;
+
+    for (i = 0; i < sizeof(*info); i++)
+        ((u8 *)info)[i] = 0;
+
+    IRQ_DISABLE(ime);
+    stride = EnterCfi(cart, &lanes);
+    if (stride)
+    {
+        swapped = FALSE;
+        ok = ReadLane(stride, 0, info, &swapped);
+        if (swapped)
+            info->swapped |= 1;
+        if (ok && lanes == 2)
+        {
+            // Both chips must describe the same layout.
+            swapped = FALSE;
+            ok = ReadLane(stride, 1, &other, &swapped);
+            if (swapped)
+                info->swapped |= 2;
+            if (ok && (other.sizeLog2 != info->sizeLog2 || other.numRegions != info->numRegions))
+                ok = FALSE;
+            for (i = 0; ok && i < info->numRegions; i++)
+            {
+                if (other.regionBlocks[i] != info->regionBlocks[i] || other.regionSize[i] != info->regionSize[i])
+                    ok = FALSE;
+            }
+        }
+        ReproCart_ReadArrayMode(cart);
+    }
+    if (ROM_READ16(0) != header0 || ROM_READ16(2) != header1)
+    {
+        ReproCart_ReadArrayMode(cart);
+        if (ROM_READ16(0) != header0 || ROM_READ16(2) != header1)
+            ok = FALSE;
+    }
+    IRQ_RESTORE(ime);
+
+    if (!ok)
+        return FALSE;
+
+    largest = 0;
+    for (i = 0; i < info->numRegions; i++)
+    {
+        if (info->regionSize[i] > largest)
+            largest = info->regionSize[i];
+    }
+    info->lanes = lanes;
+    info->blockSize = largest * lanes;
+    info->busSize = (1u << info->sizeLog2) * lanes;
+    info->ok = TRUE;
+    return TRUE;
+}
diff --git a/repro_tools/flasher/cfi.h b/repro_tools/flasher/cfi.h
new file mode 100644
index 0000000..eed869a
--- /dev/null
+++ b/repro_tools/flasher/cfi.h
@@ -0,0 +1,26 @@
+#ifndef GUARD_CFI_H
+#define GUARD_CFI_H
+
+#include "repro_cart.h"
+
+#define CFI_MAX_REGIONS 4
+
+struct CfiInfo
+{
+    u8 ok;
+    u8 lanes;           // chips side by side on the 16-bit bus (1 or 2)
+    u8 swapped;         // bit n: lane n answers with D0/D1 swapped
+    u8 numRegions;
+    u8 sizeLog2;        // per chip
+    u8 raw[3];          // what lane 0 returned for "QRY", for diagnostics
+    u32 blockSize;      // largest erase block, in bytes of the GBA address space
+    u32 busSize;        // bytes of the GBA address space the chip(s) cover
+    u16 regionBlocks[CFI_MAX_REGIONS];
+    u32 regionSize[CFI_MAX_REGIONS];   // per chip
+};
+
+// Reads the erase block layout with a CFI query sent the way the board
+// expects (lane layout, D0/D1 swap). Leaves the chip in read-array mode.
+bool32 Cfi_Read(const struct ReproCart *cart, struct CfiInfo *info);
+
+#endif // GUARD_CFI_H
diff --git a/repro_tools/flasher/config.h b/repro_tools/flasher/config.h
new file mode 100644
index 0000000..1c2ebe6
--- /dev/null
+++ b/repro_tools/flasher/config.h
@@ -0,0 +1,49 @@
+#ifndef GUARD_FLASHER_CONFIG_H
+#define GUARD_FLASHER_CONFIG_H
+
+// Data that make_flasher.py appends to flasher_code.bin, at the first
+// 32-byte boundary after the code. Everything here comes from the user's own
+// ROM dump and the repro patch; the code itself carries no ROM data.
+//
+// Layout after the struct:
+//   u32 origHash[n]    hash of each 4 KiB chunk of [hashStart, hashEnd) in the dump
+//   u32 targetHash[n]  the same with the new program bytes in place
+//   u8  newBytes[overlayEnd - overlayStart], zero-padded to 32 bytes
+// where n = (hashEnd - hashStart) / HASH_CHUNK.
+//
+// Hashes are FNV-1a over little-endian 32-bit words: h = (h ^ w) * 0x01000193,
+// starting from HASH_BASIS (see hash.s and make_flasher.py).
+
+#define FLASHER_MAGIC    0x48534C46 // "FLSH"
+#define FLASHER_VERSION  1
+#define HASH_CHUNK       0x1000
+#define HASH_BASIS       0x811C9DC5
+#define MAX_ID_RANGES    6
+
+struct FlasherConfig
+{
+    // 0x00
+    u32 magic;
+    u32 version;
+    u32 totalSize;      // bytes from the start of this struct, a multiple of 32
+    u32 bodyHash;       // hash of bytes [0x20, totalSize)
+    u32 pad[4];
+    // 0x20
+    u32 gameCode;       // cart header game code at 0xAC ("BPEE")
+    u32 programAddr;    // ROM offset of Emerald's built-in Colosseum program
+    u32 programSize;    // used size of the new program
+    u32 saveAddr;       // ROM offset of the batteryless save area (never written)
+    u32 overlayStart;   // first ROM offset where the new program differs
+    u32 overlayEnd;     // end of that span
+    u32 hashStart;      // overlay span rounded out to 256 KiB
+    u32 hashEnd;
+    // 0x40
+    u32 testAddr;       // 512 KiB aligned; [testAddr - 512K, testAddr + 512K) is 0xFF in the dump
+    u32 stagingAddr;    // 256 KiB aligned; [stagingAddr, +256K) is 0xFF in the dump
+    u32 numIdRanges;
+    u32 idHash;         // hash over all idRanges in order
+    u32 idRanges[MAX_ID_RANGES][2]; // [start, end), 32-byte aligned ROM offsets
+    // 0x80
+};
+
+#endif // GUARD_FLASHER_CONFIG_H
diff --git a/repro_tools/flasher/console.c b/repro_tools/flasher/console.c
new file mode 100644
index 0000000..f4f2184
--- /dev/null
+++ b/repro_tools/flasher/console.c
@@ -0,0 +1,145 @@
+// Minimal text console: mode 0, BG0, 4bpp font tiles 0-95 for ASCII 0x20-0x7F.
+#include "repro_types.h"
+#include "gba/io_reg.h"
+#include "console.h"
+#include "font_data.h"
+
+#define CHAR_BASE  ((vu32 *)0x06000000)
+#define SCREEN     ((vu16 *)0x0600F800)   // screen base block 31
+#define BG_PALETTE ((vu16 *)0x05000000)
+#define RGB(r, g, b) ((r) | ((g) << 5) | ((b) << 10))
+
+static u8 sX;
+static u8 sY;
+static u16 sAttr;
+
+static const u16 sColors[] =
+{
+    [COLOR_WHITE]  = RGB(31, 31, 31),
+    [COLOR_GREEN]  = RGB(10, 31, 10),
+    [COLOR_RED]    = RGB(31, 10, 8),
+    [COLOR_YELLOW] = RGB(31, 29, 6),
+    [COLOR_GRAY]   = RGB(19, 19, 21),
+};
+
+void Con_Init(void)
+{
+    u32 i;
+
+    REG_DISPCNT = 0x0080; // forced blank while VRAM is set up
+    for (i = 0; i < 96 * 8; i++)
+        CHAR_BASE[i] = gFontTiles[i];
+    for (i = 0; i < 32 * 32; i++)
+        SCREEN[i] = 0;
+    BG_PALETTE[0] = RGB(1, 3, 9);
+    for (i = 0; i < sizeof(sColors) / sizeof(sColors[0]); i++)
+        BG_PALETTE[i * 16 + 1] = sColors[i];
+    REG_BG0CNT = 31 << 8;
+    REG_BG0HOFS = 0;
+    REG_BG0VOFS = 0;
+    REG_DISPCNT = DISPCNT_MODE_0 | DISPCNT_BG0_ON;
+    sX = 0;
+    sY = 0;
+    sAttr = 0;
+}
+
+void Con_SetColor(u32 color)
+{
+    sAttr = color << 12;
+}
+
+static void NewLine(void)
+{
+    u32 i;
+
+    sX = 0;
+    if (sY < CON_ROWS - 1)
+    {
+        sY++;
+        return;
+    }
+    for (i = 0; i < 32 * (CON_ROWS - 1); i++)
+        SCREEN[i] = SCREEN[i + 32];
+    for (i = 0; i < 32; i++)
+        SCREEN[32 * (CON_ROWS - 1) + i] = 0;
+}
+
+void Con_Putc(u32 c)
+{
+    if (c == '\n')
+    {
+        NewLine();
+        return;
+    }
+    if (c < 0x20 || c > 0x7F)
+        c = '?';
+    SCREEN[sY * 32 + sX] = (c - 0x20) | sAttr;
+    if (++sX == CON_COLS)
+        NewLine();
+}
+
+void Con_Print(const char *s)
+{
+    while (*s)
+        Con_Putc(*s++);
+}
+
+void Con_Hex(u32 value, u32 digits)
+{
+    static const char hex[] = "0123456789ABCDEF";
+
+    while (digits--)
+        Con_Putc(hex[(value >> (digits * 4)) & 0xF]);
+}
+
+void Con_Dec(u32 value)
+{
+    static const u32 powers[] = {1000000000, 100000000, 10000000, 1000000, 100000, 10000, 1000, 100, 10, 1};
+    u32 i, digit;
+    bool32 started = FALSE;
+
+    for (i = 0; i < sizeof(powers) / sizeof(powers[0]); i++)
+    {
+        digit = 0;
+        while (value >= powers[i])
+        {
+            value -= powers[i];
+            digit++;
+        }
+        if (digit || started || powers[i] == 1)
+        {
+            Con_Putc('0' + digit);
+            started = TRUE;
+        }
+    }
+}
+
+void Con_ClearLine(void)
+{
+    u32 i;
+
+    for (i = 0; i < 32; i++)
+        SCREEN[sY * 32 + i] = 0;
+    sX = 0;
+}
+
+void Con_Bar(u32 done, u32 total)
+{
+    u32 width = CON_COLS - sX;
+    u32 filled = 0;
+    u32 i;
+
+    // filled = done * width / total, without division
+    if (total)
+    {
+        u32 acc = 0;
+        for (i = 0; i < width; i++)
+        {
+            acc += total;
+            if (acc <= done * width)
+                filled++;
+        }
+    }
+    for (i = 0; i < width; i++)
+        SCREEN[sY * 32 + sX + i] = (i < filled ? 0x7F - 0x20 : '.' - 0x20) | (COLOR_GRAY << 12);
+}
