diff --git a/repro_tools/flasher/savewriter.c b/repro_tools/flasher/savewriter.c
new file mode 100644
index 0000000..ca677fc
--- /dev/null
+++ b/repro_tools/flasher/savewriter.c
@@ -0,0 +1,803 @@
+// Emerald save writer.
+//
+// A GBA multiboot program, sent like the flasher, that writes a 128 KiB
+// Emerald save file into the save area of a batteryless repro cart, where the
+// cart's own code keeps the save (in ROM flash). make_save_writer.py builds it
+// from the user's dump and the save file, typically one that extract_save.py
+// pulled out of a dump and PKHeX edited.
+//
+// The same safety design as the flasher (main.c), whose helpers are repeated
+// here so that the shipped flasher stays exactly as tested:
+//  - nothing is written until the cart matches the dump outside the areas that
+//    legitimately change, and the user confirms with L+R+A;
+//  - the erase block size comes from CFI and is checked by experiment in an
+//    area that is unused in the dump, before the save area is erased;
+//  - the image carries the whole save, so if power is lost while writing,
+//    sending it again finishes the job;
+//  - only the save area (rounded out to the erase block, where the dump holds
+//    0xFF) and the unused test area are ever written.
+
+#include "repro_types.h"
+#include "repro_hw.h"
+#include "repro_cart.h"
+#include "gba/io_reg.h"
+#include "console.h"
+#include "cfi.h"
+#include "config.h"
+#include "savewriter_config.h"
+
+#define VERSION "v0.1"
+
+#define ROM8(off)     (*(vu8 *)(0x08000000 + (off)))
+#define ROM_ADDR(off) ((const void *)(0x08000000 + (off)))
+
+#define KEY_A 0x0001
+#define KEY_R 0x0100
+#define KEY_L 0x0200
+
+#define MIN_BLOCK 0x1000
+#define MAX_BLOCK 0x40000
+#define PIECE_MAX 0x10000 // one SRAM bank of data per program pass
+
+#define SECTOR_SIZE      0x1000
+#define SECTORS_PER_SLOT 14
+#define SECTOR_SIGNATURE 0x08012025
+
+// Errors of this program; the chip layer uses 0x81xx (repro_cart.h).
+#define ERR_BLOCK_SMALLER 0x8201
+#define ERR_BLOCK_LARGER  0x8202
+#define ERR_WRITE_VERIFY  0x8204
+#define ERR_MARK_VERIFY   0x8206
+#define ERR_SIZE_TEST     0x8207
+
+struct SaveInfo
+{
+    bool8 valid;
+    u8 name[8];
+    u16 trainerId;
+    u16 hours;
+    u8 minutes;
+    u32 counter;
+};
+
+extern u8 __image_end[];
+u32 HashWords(const void *src, u32 bytes, u32 h);
+
+// HashWords is ARM code in IWRAM, out of BL range: call it through a pointer.
+u32 (*gHashWords)(const void *src, u32 bytes, u32 h) = HashWords;
+
+static const struct SaveWriterConfig *sCfg;
+static const u8 *sSave;
+static struct ReproCart sCart;
+static struct CfiInfo sCfi;
+static u32 sBlock;
+static u32 sPiece;
+static u32 sFFHash;
+static u32 sErrorAddr;
+static u32 sProgDone;
+static u16 sTestError;
+static bool8 sWriteStarted;
+
+static const char *const sTypeNames[] =
+{
+    [REPRO_CART_UNKNOWN]        = "unknown",
+    [REPRO_CART_INTEL_BUFFERED] = "Intel, buffered",
+    [REPRO_CART_INTEL_WORD]     = "Intel, word",
+    [REPRO_CART_AMD_SWAPPED]    = "AMD x16, D0/D1 swap",
+    [REPRO_CART_AMD_DUAL]       = "AMD, two x8 chips",
+    [REPRO_CART_AMD_X16]        = "AMD x16 (no support)",
+};
+
+// ---------------------------------------------------------------- system
+
+void WaitVBlank(void)
+{
+    while (REG_VCOUNT >= 160)
+        ;
+    while (REG_VCOUNT < 160)
+        ;
+}
+
+static void WaitFrames(u32 frames)
+{
+    while (frames--)
+        WaitVBlank();
+}
+
+u16 ReadKeys(void)
+{
+    return ~REG_KEYINPUT & 0x3FF;
+}
+
+// The end of every run; the GBA is turned off from here.
+void Finish(u32 code)
+{
+    for (;;)
+        WaitVBlank();
+}
+
+static void Fail(const char *msg)
+{
+    Con_SetColor(COLOR_RED);
+    Con_Print(msg);
+    Con_SetColor(COLOR_WHITE);
+    Finish(1);
+}
+
+static void PrintOk(void)
+{
+    Con_SetColor(COLOR_GREEN);
+    Con_Print(" ok\n");
+    Con_SetColor(COLOR_WHITE);
+}
+
+static void WaitConfirm(void)
+{
+    u16 keys;
+    u16 prev = 0;
+
+    // Start+Select may still be held from booting into multiboot.
+    while (ReadKeys())
+        WaitVBlank();
+    for (;;)
+    {
+        WaitVBlank();
+        keys = ReadKeys();
+        if ((keys & (KEY_L | KEY_R)) == (KEY_L | KEY_R) && (keys & KEY_A) && !(prev & KEY_A))
+            return;
+        prev = keys;
+    }
+}
+
+void ErrorWait(u32 code)
+{
+    while (ReadKeys())
+        WaitVBlank();
+    while (!(ReadKeys() & KEY_A))
+        WaitVBlank();
+}
+
+static void PrintDecPadded(u32 value, u32 digits)
+{
+    static const u32 powers[] = {10000, 1000, 100, 10, 1};
+    u32 i, digit;
+
+    for (i = 5 - digits; i < 5; i++)
+    {
+        digit = 0;
+        while (value >= powers[i])
+        {
+            value -= powers[i];
+            digit++;
+        }
+        Con_Putc('0' + digit);
+    }
+}
+
+// ---------------------------------------------------------------- data
+
+static bool32 ConfigOk(void)
+{
+    sCfg = (const struct SaveWriterConfig *)(((u32)__image_end + 31) & ~31);
+    if (sCfg->magic != SAVEWRITER_MAGIC || sCfg->version != SAVEWRITER_VERSION)
+        return FALSE;
+    if (sCfg->totalSize < sizeof(struct SaveWriterConfig) || (sCfg->totalSize & 31)
+     || (u32)sCfg + sCfg->totalSize > 0x02040000)
+        return FALSE;
+    if (gHashWords((const u8 *)sCfg + 0x20, sCfg->totalSize - 0x20, HASH_BASIS) != sCfg->bodyHash)
+        return FALSE;
+    if (sCfg->numIdRanges > MAX_ID_RANGES || sCfg->saveSize != SECTOR_SIZE * 32
+     || sizeof(struct SaveWriterConfig) + sCfg->saveSize > sCfg->totalSize
+     || (sCfg->saveAddr & (SECTOR_SIZE - 1)) || sCfg->areaStart > sCfg->saveAddr
+     || sCfg->areaEnd < sCfg->saveAddr + sCfg->saveSize)
+        return FALSE;
+    sSave = (const u8 *)(sCfg + 1);
+    return TRUE;
+}
+
+static u32 ChunkHash(u32 off)
+{
+    return gHashWords(ROM_ADDR(off), HASH_CHUNK, HASH_BASIS);
+}
+
+static u32 FFHash(void)
+{
+    static const u32 ones[8] = {~0u, ~0u, ~0u, ~0u, ~0u, ~0u, ~0u, ~0u};
+    u32 h = HASH_BASIS;
+    u32 i;
+
+    for (i = 0; i < HASH_CHUNK; i += sizeof(ones))
+        h = gHashWords(ones, sizeof(ones), h);
+    return h;
+}
+
+static bool32 IsErased(u32 addr, u32 len)
+{
+    u32 i;
+
+    for (i = 0; i < len; i += HASH_CHUNK)
+    {
+        if (ChunkHash(addr + i) != sFFHash)
+            return FALSE;
+    }
+    return TRUE;
+}
+
+static bool32 IdentityOk(void)
+{
+    u32 h = HASH_BASIS;
+    u32 i;
+
+    for (i = 0; i < sCfg->numIdRanges; i++)
+        h = gHashWords(ROM_ADDR(sCfg->idRanges[i][0]), sCfg->idRanges[i][1] - sCfg->idRanges[i][0], h);
+    return h == sCfg->idHash;
+}
+
+static bool32 CartPresent(void)
+{
+    return *(vu32 *)0x080000AC == sCfg->gameCode;
+}
+
+static void WaitForCart(void)
+{
+    if (CartPresent())
+        return;
+    Con_Print("Insert the Emerald cart.\n");
+    do
+    {
+        while (!CartPresent())
+            WaitVBlank();
+        WaitFrames(60);
+    } while (!CartPresent());
+}
+
+static bool32 InSave(u32 addr)
+{
+    return addr >= sCfg->saveAddr && addr < sCfg->saveAddr + sCfg->saveSize;
+}
+
+// What ROM offset 'addr' should hold once written: the new save inside the
+// save area, the erased state around it.
+static u8 TargetByte(u32 addr)
+{
+    return InSave(addr) ? sSave[addr - sCfg->saveAddr] : 0xFF;
+}
+
+static bool32 BlockIsTarget(u32 x)
+{
+    u32 i, want;
+
+    for (i = 0; i < sBlock; i += HASH_CHUNK)
+    {
+        if (InSave(x + i))
+            want = gHashWords(sSave + (x + i - sCfg->saveAddr), HASH_CHUNK, HASH_BASIS);
+        else
+            want = sFFHash;
+        if (ChunkHash(x + i) != want)
+            return FALSE;
+    }
+    return TRUE;
+}
+
+// ---------------------------------------------------------------- save info
+
+static u32 Get32(const u8 *p)
+{
+    return p[0] | (p[1] << 8) | (p[2] << 16) | (p[3] << 24);
+}
+
+static u16 Get16(const u8 *p)
+{
+    return p[0] | (p[1] << 8);
+}
+
+// The slot Emerald loads: 14 signed sectors with ids 0-13 and one save count,
+// the higher count winning. Checksums are checked by make_save_writer.py;
+// this is only for the screen.
+static void ReadSaveInfo(const u8 *save, struct SaveInfo *info)
+{
+    u32 slot, i, id, seen, counter;
+    const u8 *sector;
+    const u8 *sb2;
+
+    info->valid = FALSE;
+    for (slot = 0; slot < 2; slot++)
+    {
+        seen = 0;
+        counter = 0;
+        sb2 = save;
+        for (i = 0; i < SECTORS_PER_SLOT; i++)
+        {
+            sector = save + (slot * SECTORS_PER_SLOT + i) * SECTOR_SIZE;
+            id = Get16(sector + 0xFF4);
+            if (Get32(sector + 0xFF8) != SECTOR_SIGNATURE || id >= SECTORS_PER_SLOT || (seen & (1 << id)))
+                break;
+            if (i == 0)
+                counter = Get32(sector + 0xFFC);
+            else if (Get32(sector + 0xFFC) != counter)
+                break;
+            seen |= 1 << id;
+            if (id == 0)
+                sb2 = sector;
+        }
+        if (i < SECTORS_PER_SLOT || (info->valid && counter <= info->counter))
+            continue;
+        info->valid = TRUE;
+        info->counter = counter;
+        for (i = 0; i < 7; i++)
+            info->name[i] = sb2[i];
+        info->name[7] = 0xFF;
+        info->trainerId = Get16(sb2 + 0x0A);
+        info->hours = Get16(sb2 + 0x0E);
+        info->minutes = sb2[0x10];
+    }
+}
+
+static u32 GameChar(u8 c)
+{
+    if (c >= 0xBB && c <= 0xD4)
+        return 'A' + (c - 0xBB);
+    if (c >= 0xD5 && c <= 0xEE)
+        return 'a' + (c - 0xD5);
+    if (c >= 0xA1 && c <= 0xAA)
+        return '0' + (c - 0xA1);
+    switch (c)
+    {
+    case 0x00: return ' ';
+    case 0xAB: return '!';
+    case 0xAC: return '?';
+    case 0xAD: return '.';
+    case 0xAE: return '-';
+    case 0xB8: return ',';
+    case 0xBA: return '/';
+    }
+    return '?';
+}
+
+static void PrintSaveInfo(const char *label, const struct SaveInfo *info)
+{
+    u32 i;
+
+    Con_Print(label);
+    if (!info->valid)
+    {
+        Con_Print(" none\n");
+        return;
+    }
+    Con_Print("\n  ");
+    for (i = 0; i < 7 && info->name[i] != 0xFF; i++)
+        Con_Putc(GameChar(info->name[i]));
+    for (; i < 8; i++)
+        Con_Putc(' ');
+    Con_Print("ID ");
+    PrintDecPadded(info->trainerId, 5);
+    Con_Print("  ");
+    Con_Dec(info->hours);
+    Con_Putc(':');
+    PrintDecPadded(info->minutes < 60 ? info->minutes : 0, 2);
+    Con_Putc('\n');
+}
+
+// ---------------------------------------------------------------- flash steps
+
+static u16 FillSram(u32 addr, u32 len)
+{
+    u32 i;
+
+    for (i = 0; i < len; i++)
+        ReproSram_Write8(i, TargetByte(addr + i), sCart.bankValue);
+    for (i = 0; i < len; i++)
+    {
+        if (ReproSram_Read8(i, sCart.bankValue) != TargetByte(addr + i))
+        {
+            sErrorAddr = addr + i;
+            return REPRO_ERR_SRAM;
+        }
+    }
+    return REPRO_OK;
+}
+
+static u16 ProgramFromSram(u32 dst, u32 len)
+{
+    u32 unit = sCart.programUnit;
+    u32 off, i;
+    u16 rc;
+
+    for (off = 0; off < len; off += unit)
+    {
+        if ((off & 0xFFF) == 0)
+            Con_Bar(sProgDone + off, sBlock);
+        for (i = 0; i < unit; i++)
+        {
+            if (ReproSram_Read8(off + i, sCart.bankValue) != 0xFF)
+                break;
+        }
+        if (i == unit)
+            continue; // already the erased state
+        rc = ReproCart_ProgramUnit(&sCart, dst + off, off);
+        if (rc != REPRO_OK)
+        {
+            sErrorAddr = dst + off;
+            return rc;
+        }
+    }
+    sProgDone += len;
+    return REPRO_OK;
+}
+
+static u16 EraseChecked(u32 addr)
+{
+    u16 rc;
+
+    sErrorAddr = addr;
+    rc = ReproCart_EraseBlock(&sCart, addr);
+    if (rc != REPRO_OK)
+        rc = ReproCart_EraseBlock(&sCart, addr);
+    if (rc == REPRO_OK && !IsErased(addr, sBlock))
+        rc = REPRO_ERR_VERIFY;
+    return rc;
+}
+
+static void StepStart(u32 addr, const char *what)
+{
+    Con_ClearLine();
+    Con_Hex(addr, 6);
+    Con_Print(what);
+    sProgDone = 0;
+    Con_Bar(0, sBlock);
+}
+
+static void StepDone(u32 addr, const char *what)
+{
+    Con_ClearLine();
+    Con_Hex(addr, 6);
+    Con_Print(what);
+    PrintOk();
+}
+
+static u8 MarkByte(u32 i)
+{
+    return 0xA5 ^ i;
+}
+
+static bool32 MarkPresent(u32 addr)
+{
+    u32 i;
+
+    for (i = 0; i < sCart.programUnit; i++)
+    {
+        if (ROM8(addr + i) != MarkByte(i))
+            return FALSE;
+    }
+    return TRUE;
+}
+
+// Checks that one erase command clears exactly sBlock bytes, in the test area
+// (unused in the dump): a marker goes in the first and last program unit of
+// the test block and next to it on each side, then the test block is erased.
+static u16 EraseSizeTest(void)
+{
+    u32 t = sCfg->testAddr;
+    u32 unit = sCart.programUnit;
+    u32 marks[4];
+    u32 i;
+    u16 rc;
+
+    marks[0] = t - unit;
+    marks[1] = t;
+    marks[2] = t + sBlock - unit;
+    marks[3] = t + sBlock;
+
+    rc = EraseChecked(t - sBlock);
+    if (rc == REPRO_OK)
+        rc = EraseChecked(t);
+    if (rc == REPRO_OK)
+        rc = EraseChecked(t + sBlock);
+    if (rc != REPRO_OK)
+        return rc;
+
+    for (i = 0; i < unit; i++)
+        ReproSram_Write8(i, MarkByte(i), sCart.bankValue);
+    for (i = 0; i < 4; i++)
+    {
+        // A marker that cannot be programmed can mean the blocks are smaller
+        // than reported (its block was not erased or unlocked). Retrying
+        // cannot fix that, so stop while only the test area has been written.
+        sErrorAddr = marks[i];
+        rc = ReproCart_ProgramUnit(&sCart, marks[i], 0);
+        if (rc == REPRO_OK && !MarkPresent(marks[i]))
+            rc = ERR_MARK_VERIFY;
+        if (rc != REPRO_OK)
+        {
+            sTestError = rc;
+            return ERR_SIZE_TEST;
+        }
+    }
+
+    sErrorAddr = t;
+    rc = ReproCart_EraseBlock(&sCart, t);
+    if (rc != REPRO_OK)
+        rc = ReproCart_EraseBlock(&sCart, t);
+    if (rc != REPRO_OK)
+        return rc;
+    if (!IsErased(t, sBlock))
+        return ERR_BLOCK_SMALLER;
+    if (!MarkPresent(marks[0]) || !MarkPresent(marks[3]))
+        return ERR_BLOCK_LARGER;
+    return REPRO_OK;
+}
+
+static bool32 TestAreaClean(void)
+{
+    return IsErased(sCfg->testAddr - sBlock, 3 * sBlock);
+}
+
+static u16 CleanTestArea(void)
+{
+    u32 b;
+    u16 rc;
+
+    for (b = sCfg->testAddr - sBlock; b < sCfg->testAddr + 2 * sBlock; b += sBlock)
+    {
+        if (!IsErased(b, sBlock))
+        {
+            rc = EraseChecked(b);
+            if (rc != REPRO_OK)
+                return rc;
+        }
+    }
+    return REPRO_OK;
+}
+
+static u16 WriteBlock(u32 x)
+{
+    u32 p;
+    u16 rc;
+
+    StepStart(x, " write ");
+    sWriteStarted = TRUE;
+    rc = EraseChecked(x);
+    for (p = 0; p < sBlock && rc == REPRO_OK; p += sPiece)
+    {
+        rc = FillSram(x + p, sPiece);
+        if (rc == REPRO_OK)
+            rc = ProgramFromSram(x + p, sPiece);
+    }
+    if (rc != REPRO_OK)
+        return rc;
+    sErrorAddr = x;
+    if (!BlockIsTarget(x))
+        return ERR_WRITE_VERIFY;
+    StepDone(x, " write ");
+    return REPRO_OK;
+}
+
+static u16 WriteAll(u32 first, u32 end)
+{
+    u32 x;
+    u16 rc;
+
+    ReproSram_ForgetBank();
+
+    Con_Print("Erase test in spare area");
+    rc = EraseSizeTest();
+    if (rc != REPRO_OK)
+        return rc;
+    PrintOk();
+
+    for (x = first; x < end; x += sBlock)
+    {
+        if (BlockIsTarget(x))
+        {
+            StepDone(x, " already done");
+            continue;
+        }
+        rc = WriteBlock(x);
+        if (rc != REPRO_OK)
+            rc = WriteBlock(x);
+        if (rc != REPRO_OK)
+            return rc;
+    }
+
+    Con_Print("Erase spare area again");
+    rc = CleanTestArea();
+    if (rc != REPRO_OK)
+        return rc;
+    PrintOk();
+    return REPRO_OK;
+}
+
+static const char *ErrorText(u16 rc)
+{
+    switch (rc)
+    {
+    case REPRO_ERR_TIMEOUT:  return "The chip did not finish.";
+    case REPRO_ERR_STATUS:   return "The chip reported a failure.";
+    case REPRO_ERR_VERIFY:   return "Data read back wrong.";
+    case REPRO_ERR_SRAM:     return "Cart SRAM read back wrong.";
+    case REPRO_ERR_LOCKED:   return "A block stayed locked.";
+    case ERR_BLOCK_SMALLER:  return "Erase blocks are smaller\nthan the chip reports.";
+    case ERR_BLOCK_LARGER:   return "Erase blocks are larger\nthan the chip reports.";
+    case ERR_WRITE_VERIFY:   return "The save read back wrong.";
+    case ERR_MARK_VERIFY:    return "Test marker read back wrong.";
+    case ERR_SIZE_TEST:      return "The erase test failed.";
+    }
+    return "Unknown error.";
+}
+
+static bool32 IsFatal(u16 rc)
+{
+    return rc == ERR_BLOCK_SMALLER || rc == ERR_BLOCK_LARGER || rc == ERR_SIZE_TEST;
+}
+
+// Raw answers to the probe's own ID queries, for chips it did not recognise.
+static void ShowChipIds(void)
+{
+    u16 ime;
+    u16 header1 = ROM_READ16(2);
+    u16 id0, id1;
+
+    IRQ_DISABLE(ime);
+    ROM_WRITE16(0, 0xFF);
+    ROM_WRITE16(0, 0x50);
+    ROM_WRITE16(0, 0x90);
+    id0 = ROM_READ16(0);
+    id1 = ROM_READ16(2);
+    ROM_WRITE16(0, 0xFF);
+    Con_Print("Intel ID ");
+    Con_Hex(id0, 4);
+    Con_Putc(' ');
+    Con_Hex(id1, 4);
+    Con_Putc('\n');
+    if (id1 == header1)
+    {
+        ROM_WRITE16(0, 0xF0);
+        ROM_WRITE16(0xAAA, 0xA9);
+        ROM_WRITE16(0x554, 0x56);
+        ROM_WRITE16(0xAAA, 0x90);
+        id0 = ROM_READ16(0);
+        id1 = ROM_READ16(2);
+        ROM_WRITE16(0, 0xF0);
+        Con_Print("AMD ID ");
+        Con_Hex(id0, 4);
+        Con_Putc(' ');
+        Con_Hex(id1, 4);
+        Con_Putc('\n');
+    }
+    ROM_WRITE16(0, 0xF0F0);
+    ROM_WRITE16(0, 0xFFFF);
+    IRQ_RESTORE(ime);
+}
+
+void AgbMain(void)
+{
+    const struct ReproCart *probed;
+    struct SaveInfo cartInfo, newInfo;
+    u32 first, end, x, i;
+    u16 rc;
+
+    REG_WAITCNT = 0x4014; // the same as Emerald: ROM 3/1 wait states, SRAM 4
+    Con_Init();
+    Con_SetColor(COLOR_YELLOW);
+    Con_Print("Emerald save writer " VERSION "\n\n");
+    Con_SetColor(COLOR_WHITE);
+
+    if (!ConfigOk())
+        Fail("This file is incomplete.\nBuild it again with\nmake_save_writer.py.\n");
+    sFFHash = FFHash();
+    WaitForCart();
+
+    Con_Print("Cart matches your dump");
+    if (!IdentityOk())
+    {
+        Con_Putc('?');
+        Con_Putc('\n');
+        Fail("No. This only writes to the\ncart it was built for.\nNothing was written.\n");
+    }
+    PrintOk();
+
+    probed = ReproCart_Probe();
+    for (i = 0; i < sizeof(sCart); i++)
+        ((u8 *)&sCart)[i] = ((const u8 *)probed)[i];
+    Con_Print("Chip: ");
+    Con_Print(sTypeNames[sCart.type]);
+    Con_Putc('\n');
+    if (!sCart.supported)
+    {
+        if (sCart.type == REPRO_CART_UNKNOWN)
+            ShowChipIds();
+        Fail("This board type is not\nsupported. Nothing was\nwritten.\n");
+    }
+
+    if (!Cfi_Read(&sCart, &sCfi))
+    {
+        Con_Print("CFI: no answer (");
+        Con_Hex(sCfi.raw[0], 2);
+        Con_Hex(sCfi.raw[1], 2);
+        Con_Hex(sCfi.raw[2], 2);
+        Con_Print(")\n");
+        Fail("Can't read the chip's block\nlayout. Nothing was written.\n");
+    }
+    sBlock = sCfi.blockSize;
+    Con_Print("Blocks: ");
+    Con_Dec(sBlock / 1024);
+    Con_Print(" KB, chip ");
+    Con_Dec(sCfi.busSize >> 20);
+    Con_Print(" MB\n");
+    first = sCfg->saveAddr & ~(sBlock - 1);
+    end = (sCfg->saveAddr + sCfg->saveSize + sBlock - 1) & ~(sBlock - 1);
+    if (sBlock < MIN_BLOCK || sBlock > MAX_BLOCK || (sBlock & (sBlock - 1)) || sCfi.busSize < 0x1000000
+     || first < sCfg->areaStart || end > sCfg->areaEnd)
+        Fail("This block layout is not\nsupported. Nothing was\nwritten.\n");
+    sPiece = sBlock < PIECE_MAX ? sBlock : PIECE_MAX;
+
+    ReadSaveInfo(ROM_ADDR(sCfg->saveAddr), &cartInfo);
+    ReadSaveInfo(sSave, &newInfo);
+    PrintSaveInfo("On the cart:", &cartInfo);
+    PrintSaveInfo("New save:", &newInfo);
+
+    for (x = first; x < end; x += sBlock)
+    {
+        if (!BlockIsTarget(x))
+            break;
+    }
+    if (x >= end)
+    {
+        if (TestAreaClean())
+        {
+            Con_SetColor(COLOR_GREEN);
+            Con_Print("\nThe cart already holds this\nsave. Nothing to do.\n");
+            Finish(0);
+        }
+        // Power was lost while the test area was being erased again.
+        Con_Print("Save already written. The\nspare area still holds data\nfrom a stopped run: erase it.\n");
+    }
+    else
+    {
+        Con_Print("Will rewrite ");
+        Con_Hex(first, 6);
+        Con_Putc('-');
+        Con_Hex(end - 1, 6);
+        Con_Putc('\n');
+    }
+    Con_SetColor(COLOR_YELLOW);
+    Con_Print("\nThe cart's save will be\nreplaced. Keep the GBA on.\nTo write, hold L+R, press A.\nTo cancel, turn the GBA off.\n\n");
+    Con_SetColor(COLOR_WHITE);
+
+    WaitConfirm();
+
+    for (;;)
+    {
+        rc = WriteAll(first, end);
+        if (rc == REPRO_OK)
+            break;
+        Con_Putc('\n');
+        Con_SetColor(COLOR_RED);
+        Con_Print("Error ");
+        Con_Hex(rc, 4);
+        Con_Print(" at ");
+        Con_Hex(sErrorAddr, 6);
+        Con_Putc('\n');
+        Con_Print(ErrorText(rc));
+        Con_Putc('\n');
+        if (rc == ERR_SIZE_TEST)
+        {
+            Con_Print("Chip error ");
+            Con_Hex(sTestError, 4);
+            Con_Putc('\n');
+        }
+        Con_SetColor(COLOR_WHITE);
+        if (IsFatal(rc))
+        {
+            Con_Print(sWriteStarted ? "The save was partly written:\nsend this again to finish.\n"
+                                    : "The save was not changed.\n");
+            Fail("Stopped. Turn the GBA off\nand report this screen.\n");
+        }
+        Con_Print("Press A to try again. Or\nturn off and send this again\nlater to finish the write.\n");
+        ErrorWait(rc);
+    }
+
+    Con_SetColor(COLOR_GREEN);
+    Con_Print("\nDone. Turn the GBA off.\n");
+    Finish(0);
+}
